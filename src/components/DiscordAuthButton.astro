---
// src/components/DiscordAuthButton.astro
import { verifySession } from '../utils/session';
import { getUserByDiscordId } from '../utils/db';

const sessionCookie = Astro.cookies.get('user_session')?.value;
let user: { 
  id: string; 
  username: string; 
  displayName: string; 
  avatar: string; 
  email?: string;
  memberId?: number | null;
  memberName?: string | null;
  role?: string;
} | null = null;

if (sessionCookie) {
  const env = (Astro.locals as any).runtime?.env ?? {};
  const sessionSecret = env.SESSION_SECRET || import.meta.env.SESSION_SECRET || 'anki_challenge_secret_key_2026_super_secure';
  user = await verifySession<typeof user>(sessionCookie, sessionSecret) ?? null;

  // Lấy trạng thái ghép nối thành viên từ D1
  if (user?.id && env.DB) {
    try {
      const profile = await getUserByDiscordId(env.DB, user.id);
      if (profile) {
        user.memberId = profile.id;
        user.memberName = profile.name;
        user.role = profile.role;
      }
    } catch (e) {
      console.warn('[DiscordAuthButton db lookup error]', e);
    }
  }
}
---

<div class="relative inline-block text-left shrink-0">
  {user ? (
    <div class="flex items-center gap-1 bg-[#F3EFEA] hover:bg-[#EAE4DC] border border-[#E6DFD8] p-1 pr-1.5 rounded-xl shadow-xs transition-all shrink-0">
      {user.memberId ? (
        <a
          href={`/profile/${user.memberId}`}
          title={`Hồ sơ thành viên: ${user.memberName || user.displayName} (#${user.memberId})`}
          class="flex items-center gap-2 px-1.5 py-0.5 rounded-lg hover:bg-black/5 transition-colors group/user"
        >
          <div class="relative shrink-0">
            <img
              src={user.avatar}
              alt={user.displayName}
              class="w-7 h-7 rounded-full border border-[#CC785C]/50 object-cover shadow-xs group-hover/user:scale-105 transition-transform"
            />
            <span class="absolute -bottom-0.5 -right-0.5 bg-[#5DB872] w-2.5 h-2.5 rounded-full border border-white" title="Đã ghép nối hồ sơ"></span>
          </div>
          <div class="flex flex-col text-left">
            <span class="text-xs font-bold text-[#141413] group-hover/user:text-[#CC785C] transition-colors leading-tight max-w-[85px] sm:max-w-[125px] truncate">
              {user.memberName || user.displayName}
            </span>
            <span class="text-[10px] text-[#8E8B82] font-mono leading-none">
              @{user.username}
            </span>
          </div>
        </a>
      ) : (
        <div class="flex items-center gap-2 px-1.5 py-0.5">
          <div class="relative shrink-0">
            <img
              src={user.avatar}
              alt={user.displayName}
              class="w-7 h-7 rounded-full border border-[#8E8B82]/40 object-cover shadow-xs"
            />
            <span class="absolute -bottom-0.5 -right-0.5 bg-[#E8A55A] w-2.5 h-2.5 rounded-full border border-white" title="Chưa ghép nối hồ sơ"></span>
          </div>
          <div class="flex flex-col text-left">
            <span class="text-xs font-bold text-[#141413] leading-tight max-w-[85px] sm:max-w-[125px] truncate">
              {user.displayName}
            </span>
            <span class="text-[9px] text-[#B45309] font-medium leading-none">
              Chưa ghép nối
            </span>
          </div>
        </div>
      )}

      {user.role === 'admin' && (
        <a
          href="/admin"
          title="Trang quản trị Admin"
          class="p-1.5 text-[#CC785C] hover:text-[#B8684D] hover:bg-[#CC785C]/10 rounded-lg transition-all shrink-0"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
        </a>
      )}

      <a
        href="/logout"
        title="Đăng xuất"
        class="p-1.5 text-[#8E8B82] hover:text-[#C64545] hover:bg-[#C64545]/10 rounded-lg transition-all shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </a>
    </div>
  ) : (
    <a
      href="/login"
      class="inline-flex items-center gap-2 bg-[#5865F2] hover:bg-[#4752C4] active:scale-[0.98] text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-xs transition-all duration-200 cursor-pointer shrink-0"
    >
      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 127.14 96.36">
        <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.68,1.76,1.36,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-20.95-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.92,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.2,45.92,96.07,53,91,65.69,84.69,65.69Z"/>
      </svg>
      <span>Đăng nhập</span>
    </a>
  )}
</div>
