---
import Layout from "../layouts/Layout.astro";
import ProgressBar from "../components/ProgressBar.astro";
import DiscordAuthButton from "../components/DiscordAuthButton.astro";
import { verifySession } from "../utils/session";

const sessionCookie = Astro.cookies.get('user_session')?.value;
let loggedUser: { id: string; username: string; displayName: string; avatar: string; memberId?: number | null; memberName?: string | null } | null = null;

if (sessionCookie) {
  const env = (Astro.locals as any).runtime?.env ?? {};
  const sessionSecret = env.SESSION_SECRET || import.meta.env.SESSION_SECRET || 'anki_challenge_secret_key_2026_super_secure';
  loggedUser = await verifySession<typeof loggedUser>(sessionCookie, sessionSecret) ?? null;
}
---

<Layout title="Anki Challenge - Bảng xếp hạng">
	<main
		class="min-h-screen bg-[#FAF9F5] text-[#141413] font-['Plus_Jakarta_Sans','Inter',sans-serif] relative overflow-x-hidden selection:bg-[#CC785C]/20 selection:text-[#141413]"
	>
		<!-- Warm Ambient Glows -->
		<div class="fixed top-[-10%] left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#CC785C]/5 blur-[140px] rounded-full pointer-events-none z-0"></div>
		<div class="fixed bottom-[-10%] right-[-5%] w-[450px] h-[450px] bg-[#E8A55A]/5 blur-[150px] rounded-full pointer-events-none z-0"></div>

		<div class="max-w-5xl mx-auto px-4 py-8 relative z-10 min-h-screen flex flex-col">
			<!-- Header Section -->
			<div class="flex flex-col md:flex-row items-center justify-between mb-8 gap-6">
				<div class="flex flex-col items-center md:items-start gap-1">
					<div class="flex items-center gap-3">
						<span class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-[#F0EAE1] text-[#CC785C] border border-[#E6DFD8] shadow-xs">
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
								<path d="M12 2L14.3 9.7L22 12L14.3 14.3L12 22L9.7 14.3L2 12L9.7 9.7L12 2Z"/>
							</svg>
						</span>
						<h1 class="text-3xl md:text-4xl font-serif text-[#141413] tracking-tight font-medium">
							Leaderboard
						</h1>
					</div>
					<p class="text-[#CC785C] font-mono text-xs font-bold tracking-widest uppercase mt-1 pl-12 md:pl-12" id="challengeTitle">
						100 ngày thử thách
					</p>
				</div>

				<div class="flex items-center gap-3 w-full md:w-auto justify-end flex-wrap">
					<!-- Challenge Selector -->
					<div class="relative group flex-1 md:flex-none">
						<select
							id="challengeSelect"
							class="w-full md:w-auto appearance-none bg-[#F3EFEA] hover:bg-[#EAE4DC] border border-[#E6DFD8] text-[#141413] text-xs md:text-sm font-semibold py-2.5 pl-4 pr-10 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#CC785C]/30 transition-all cursor-pointer shadow-xs"
						>
							<option value="1" class="bg-[#FAF9F5] text-[#141413]">Anki Challenge 8</option>
							<option value="2" class="bg-[#FAF9F5] text-[#141413]">Anki Challenge 9</option>
							<option value="3" class="bg-[#FAF9F5] text-[#141413]">Anki Challenge 10</option>
<option value="4" selected class="bg-[#FAF9F5] text-[#141413]">Anki Challenge 11</option>
						</select>
						<div class="absolute right-3.5 top-1/2 transform -translate-y-1/2 pointer-events-none text-[#8E8B82]">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
							</svg>
						</div>
					</div>

					<DiscordAuthButton />
				</div>
			</div>

			<!-- My Profile / Stats Banner -->
			{loggedUser && (
				<div id="myStatsBanner" class="mb-6 p-4 md:p-6 rounded-2xl bg-[#FFFFFF] border border-[#CC785C]/35 shadow-[0_4px_24px_rgba(204,120,92,0.08)] relative overflow-hidden transition-all">
					<div class="flex flex-col sm:flex-row items-center justify-between gap-4 relative z-10">
						{loggedUser.memberId ? (
							<a href={`/profile/${loggedUser.memberId}`} class="flex items-center gap-4 group cursor-pointer">
								<div class="relative shrink-0">
									<img src={loggedUser.avatar} alt={loggedUser.displayName} class="w-14 h-14 rounded-full border-2 border-[#CC785C] object-cover shadow-sm group-hover:scale-105 transition-transform" />
									<span class="absolute -bottom-0.5 -right-0.5 bg-[#5DB872] w-4 h-4 rounded-full border-2 border-white shadow" title="Đã kết nối Discord"></span>
								</div>
								<div>
									<div class="flex items-center gap-2 flex-wrap">
										<span class="text-[10px] font-bold uppercase tracking-wider text-[#CC785C] bg-[#CC785C]/10 px-2.5 py-0.5 rounded-full border border-[#CC785C]/20">Tài khoản của tôi</span>
										<span class="text-xs font-semibold text-[#2E7D47] bg-[#5DB872]/15 px-2 py-0.5 rounded-md border border-[#5DB872]/30">Đã kết nối</span>
									</div>
									<h2 class="text-xl font-serif font-bold text-[#141413] mt-1 flex items-center gap-2 group-hover:text-[#CC785C] transition-colors">
										{loggedUser.memberName || loggedUser.displayName} 
										<span class="text-xs font-normal text-[#8E8B82] font-mono">(@{loggedUser.username})</span>
									</h2>
								</div>
							</a>
						) : (
							<div class="flex items-center gap-4">
								<div class="relative shrink-0">
									<img src={loggedUser.avatar} alt={loggedUser.displayName} class="w-14 h-14 rounded-full border-2 border-[#CC785C] object-cover shadow-sm" />
									<span class="absolute -bottom-0.5 -right-0.5 bg-[#5DB872] w-4 h-4 rounded-full border-2 border-white shadow" title="Đã kết nối Discord"></span>
								</div>
								<div>
									<div class="flex items-center gap-2 flex-wrap">
										<span class="text-[10px] font-bold uppercase tracking-wider text-[#CC785C] bg-[#CC785C]/10 px-2.5 py-0.5 rounded-full border border-[#CC785C]/20">Tài khoản của tôi</span>
										<span class="text-xs font-semibold text-[#B45309] bg-[#FEF3C7] px-2 py-0.5 rounded-md border border-[#FDE68A]">Chưa liên kết</span>
									</div>
									<h2 class="text-xl font-serif font-bold text-[#141413] mt-1 flex items-center gap-2">
										{loggedUser.displayName} 
										<span class="text-xs font-normal text-[#8E8B82] font-mono">(@{loggedUser.username})</span>
									</h2>
								</div>
							</div>
						)}

						{loggedUser.memberId && (
							<div class="flex items-center gap-3 w-full sm:w-auto justify-end flex-wrap">
								<a
									href={`/profile/${loggedUser.memberId}`}
									class="w-full sm:w-auto px-4 py-2.5 bg-[#CC785C] hover:bg-[#B8684D] active:scale-[0.98] text-white font-semibold text-xs md:text-sm rounded-xl shadow-sm transition-all duration-200 cursor-pointer flex items-center justify-center gap-2"
								>
									<svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
									<span>Trang cá nhân</span>
								</a>
								<button
									id="scrollToMyRowBtn"
									class="w-full sm:w-auto px-4 py-2.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] active:scale-[0.98] text-[#141413] font-semibold text-xs md:text-sm rounded-xl transition-all duration-200 cursor-pointer flex items-center justify-center gap-2 border border-[#E6DFD8]"
								>
									<svg class="w-4 h-4 shrink-0 text-[#B8684E]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
									<span>Vị trí của tôi</span>
								</button>
							</div>
						)}
					</div>
				</div>
			)}

			<!-- Progress Bar -->
			<div>
				<ProgressBar challengeId="4" />
			</div>

			<!-- Registration Banner: AC11 -->
			<a
				href="/anki-challenge-11"
				class="group block mb-4 overflow-hidden rounded-2xl border border-[#CC785C]/30 bg-gradient-to-r from-[#FBF5EE] to-[#F6E8DC] shadow-[0_4px_20px_rgba(204,120,92,0.10)] transition-all hover:border-[#CC785C]/60 hover:shadow-[0_6px_28px_rgba(204,120,92,0.16)]"
			>
				<div class="relative flex flex-col sm:flex-row items-center justify-between gap-4 px-6 py-4">
					<!-- Left: icon + title -->
					<div class="flex items-center gap-4">
						<div class="relative shrink-0">
							<span class="flex w-11 h-11 items-center justify-center rounded-xl bg-[#CC785C] text-white shadow-sm group-hover:scale-105 transition-transform">
								<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
								</svg>
							</span>
							<span class="absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#437A55] border-2 border-[#FBF5EE]"></span>
						</div>
						<div>
							<div class="flex items-center gap-2 flex-wrap">
								<span class="text-[11px] font-bold uppercase tracking-wider text-[#CC785C]">Đăng ký mở</span>
								<span class="text-[10px] font-mono bg-[#CC785C]/10 text-[#B8684E] px-2 py-0.5 rounded-full border border-[#CC785C]/20">Bắt đầu 01/09/2026</span>
							</div>
							<h2 class="text-base font-serif font-semibold text-[#141413] mt-0.5">Đăng ký Anki Challenge 11</h2>
							<p class="text-xs text-[#8E8B82] mt-0.5">100 ngày thử thách · Điểm danh qua bot Discord</p>
						</div>
					</div>

					<!-- Right: CTA -->
					<div class="flex items-center gap-2 shrink-0">
						<span class="inline-flex items-center gap-2 bg-[#CC785C] group-hover:bg-[#B8684D] text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition-all shadow-sm">
							Đăng ký AC11
							<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
							</svg>
						</span>
					</div>
				</div>
			</a>

			<!-- Controls Bar -->
			<div class="sticky top-4 z-40 mb-6 bg-[#FAF9F5]/90 backdrop-blur-xl border border-[#E6DFD8] rounded-2xl p-2 flex flex-col sm:flex-row gap-2 shadow-[0_4px_20px_rgba(0,0,0,0.04)]">
				<div class="relative flex-1 group">
					<!-- Search -->
					<div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-[#8E8B82] group-focus-within:text-[#CC785C] transition-colors">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
						</svg>
					</div>
					<input
						type="text"
						id="searchInput"
						spellcheck="false"
						autocomplete="off"
						class="w-full pl-11 pr-8 py-2.5 bg-[#FFFFFF] border border-[#E6DFD8] rounded-xl text-[#141413] placeholder-[#8E8B82] focus:bg-[#FFFFFF] focus:border-[#CC785C] focus:ring-2 focus:ring-[#CC785C]/20 focus:outline-none transition-all text-sm font-medium shadow-2xs"
						placeholder="Tìm kiếm thành viên..."
					/>
					<button id="clearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center opacity-0 pointer-events-none text-[#8E8B82] hover:text-[#141413] transition-all duration-300">
						<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>

				<!-- Toggle Display Mode -->
				<div class="flex items-center gap-3 bg-[#F3EFEA] px-4 py-2 rounded-xl border border-[#E6DFD8] shrink-0">
					<span class="text-xs font-bold text-[#6C6A64] uppercase tracking-wider hidden sm:inline-block">Hiển thị</span>
					<label for="displayModeToggle" class="relative inline-flex items-center cursor-pointer ml-auto sm:ml-0">
						<input type="checkbox" id="displayModeToggle" class="sr-only peer" />
						<div class="w-11 h-6 bg-[#D8D2C9] peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-[#CC785C]/30 rounded-full peer peer-checked:after:translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#CC785C]"></div>
						<span class="ml-3 text-sm font-bold text-[#141413] w-20 text-center select-none" id="toggleLabel">Tên</span>
					</label>
				</div>
			</div>

			<!-- Loading State -->
			<div id="loading" class="text-center py-24">
				<div
					class="inline-flex items-center gap-3.5 px-7 py-4 rounded-2xl bg-[#FFFFFF] border border-[#E6DFD8] shadow-sm"
				>
					<div class="relative w-6 h-6">
						<div
							class="absolute inset-0 rounded-full border-2 border-[#E6DFD8]"
						>
						</div>
						<div
							class="absolute inset-0 rounded-full border-2 border-[#CC785C] border-t-transparent animate-spin"
						>
						</div>
					</div>
					<span class="text-base font-semibold text-[#141413]"
						>Đang tải dữ liệu...</span
					>
				</div>
			</div>

			<!-- Board Content -->
			<div
				id="leaderboard"
				class="hidden animate-fade-in-up group show-discord"
				data-logged-member-id={loggedUser?.memberId || ""}
			>
				<!-- Mobile Cards -->
				<div class="md:hidden space-y-3.5" id="leaderboardCards">
					<div id="leaderboardCardsBody" class="space-y-3.5"></div>
				</div>

				<!-- Desktop Cards -->
				<div class="hidden md:block space-y-3" id="leaderboardDesktopBody">
					<!-- Desktop cards injected here -->
				</div>
			</div>

			<div class="mt-12 text-center pb-8 opacity-75 hover:opacity-100 transition-opacity">
				<p
					class="inline-flex items-center px-4 py-2 rounded-full bg-[#F3EFEA] border border-[#E6DFD8] text-[#6C6A64] text-xs font-semibold uppercase tracking-wider shadow-xs"
					id="dataInfo"
				>
					<span
						class="w-2 h-2 rounded-full bg-[#5DB872] mr-2.5 animate-pulse shadow-[0_0_8px_rgba(93,184,114,0.6)]"
					></span>
					Cập nhật: <span
						id="lastUpdateStr"
						class="ml-1.5 text-[#141413] font-mono">--</span
					>
					<span class="mx-3 text-[#D8D2C9]">|</span>
					<span id="memberCountSummary" class="text-[#141413]"
						>-- thành viên</span
					>
				</p>
			</div>
		</div>
	</main>
</Layout>

<style>
	:global(*) {
		font-family: "Plus Jakarta Sans", "Inter", sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	:global(body) {
		background-color: #faf9f5;
		color: #141413;
		margin: 0;
		min-height: 100vh;
	}

	@keyframes fade-in-up {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		animation: fade-in-up 0.5s ease-out forwards;
	}

	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	::-webkit-scrollbar-track {
		background: #faf9f5;
	}

	::-webkit-scrollbar-thumb {
		background: #d8d2c9;
		border-radius: 4px;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #b8b0a4;
	}

	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}

	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
</style>

<script>
	import { calculateUserStats } from "../utils/calculateStats.js";

	let currentChallengeId = "4";
	let currentSearchQuery = "";
	type LeaderboardUser = {
		id: number;
		name?: string;
		discordNickname?: string;
		hidden?: boolean;
		role?: string;
		challengeIds?: number[];
	};
	type LeaderboardMember = LeaderboardUser & {
		streak: number;
		longestStreak: number;
		totalDays: number;
		disciplinePercentage: number;
		rank?: number;
	};
	type UsersPayload = { data?: LeaderboardUser[] };
	type ChallengeMeta = { name?: string };
	type ChallengesConfig = Record<string, ChallengeMeta>;
	type SearchTimer = ReturnType<typeof setTimeout>;
	let allMembersWithStats: LeaderboardMember[] = [];
	// Default to Discord, toggle checked state implies "Name" if unchecked or checked?
	// Let's say CHECKED = Name (On), UNCHECKED = Discord (Off) or vice versa.
	// User said "Switch Name and Discord".
	// Let's implement: OFF (Left) = Discord, ON (Right) = Name.
	let displayMode =
		localStorage.getItem("leaderboardDisplayMode") || "name";

	let challengesConfig: ChallengesConfig = {};
	let studyRecordsData: unknown = null;
	let usersData: UsersPayload | null = null;
	const leaderboardWindow = window as Window & {
		updateProgressBar?: (challengeId: string) => void;
	};

	async function loadStaticData(challengeId = "4") {
		try {
			const metadataResponse = await fetch(
				"/api/data/metadata?v=" + Date.now(),
			);
			const metadata = await metadataResponse.json();
			const cacheBuster = metadata?.lastUpdated
				? "?v=" + new Date(metadata.lastUpdated).getTime()
				: "?v=" + Date.now();

			const lastUpdateStr = document.getElementById("lastUpdateStr");
			if (lastUpdateStr && metadata?.lastUpdated) {
				const date = new Date(metadata.lastUpdated);
				lastUpdateStr.textContent = date.toLocaleString("vi-VN", {
					hour: "2-digit",
					minute: "2-digit",
					day: "2-digit",
					month: "2-digit",
				});
			}

			let prefix = '08';
			if (challengeId === "1") prefix = '08';
			if (challengeId === "2") prefix = '09';
			if (challengeId === "3") prefix = '10';
			if (challengeId === "4") prefix = '11';

			const [studyRecordsResponse, usersResponse, challengesResponse] = await Promise.all([
				fetch(`/api/data/records_${prefix}` + cacheBuster),
				fetch("/api/data/users" + cacheBuster),
				fetch("/api/data/challenges" + cacheBuster)
			]);

			studyRecordsData = await studyRecordsResponse.json();
			usersData = await usersResponse.json();
			challengesConfig = await challengesResponse.json();
		} catch (error) {
			console.error("Error loading static data:", error);
			throw error;
		}
	}

	function calculateUserStatsForLeaderboard(userId: number, challengeId: string) {
		try {
			if (!studyRecordsData || !usersData)
				return {
					streak: 0,
					longestStreak: 0,
					totalDays: 0,
					disciplinePercentage: 0,
				};

			const users = usersData.data || [];
			const user = users.find((u: LeaderboardUser) => u.id === userId);

			if (!user)
				return {
					streak: 0,
					longestStreak: 0,
					totalDays: 0,
					disciplinePercentage: 0,
				};

			const usersWithStats = calculateUserStats(
				[user],
				studyRecordsData,
				challengeId,
				challengesConfig,
			);

			if (usersWithStats.length === 0 || !usersWithStats[0].currentStat) {
				return {
					streak: 0,
					longestStreak: 0,
					totalDays: 0,
					disciplinePercentage: 0,
				};
			}

			const stat = usersWithStats[0].currentStat;

			return {
				streak: stat.streak,
				longestStreak: stat.longestStreak,
				totalDays: stat.totalDays,
				disciplinePercentage: stat.disciplinePercentage,
			};
		} catch (error) {
			console.error("[LEADERBOARD] Error calculating stats:", error);
			return {
				streak: 0,
				longestStreak: 0,
				totalDays: 0,
				disciplinePercentage: 0,
			};
		}
	}

	// --- OPTIMIZED RENDER LOGIC WITH CSS TOGGLE ---
	function getDisplayNameHTML(member: LeaderboardMember) {
		const name = member.name || "Không có tên";
		const discord = member.discordNickname || name;
		return `
			<span class="name-display hidden group-[.show-name]:inline text-ellipsis overflow-hidden whitespace-nowrap text-[#141413] font-bold">${name}</span>
			<span class="discord-display hidden group-[.show-discord]:inline text-ellipsis overflow-hidden whitespace-nowrap text-[#CC785C] font-bold font-mono text-sm">${discord}</span>
		`;
	}

	function getMobileDisplayNameHTML(member: LeaderboardMember) {
		const name = member.name || "Không có tên";
		const discord = member.discordNickname || name;
		return `
			<span class="name-display hidden group-[.show-name]:inline text-ellipsis overflow-hidden whitespace-nowrap text-[#141413] font-bold">${name}</span>
			<span class="discord-display hidden group-[.show-discord]:inline text-ellipsis overflow-hidden whitespace-nowrap text-[#CC785C] font-bold font-mono text-sm">${discord}</span>
		`;
	}

	function updateMemberCount(challengeId: string) {
		try {
			if (!usersData || !usersData.data) {
				const progressMemberCountEl = document.getElementById("progressMemberCount");
				const summaryMemberCountEl = document.getElementById("memberCountSummary");
				if (progressMemberCountEl) progressMemberCountEl.textContent = "-- thành viên";
				if (summaryMemberCountEl) summaryMemberCountEl.textContent = "-- thành viên";
				return;
			}
			const members = usersData.data || [];
			const challengeIdNum = parseInt(challengeId);
			const challengeMembers = members.filter(
				(m) =>
					!m.hidden &&
					m.challengeIds &&
					m.challengeIds.includes(challengeIdNum) &&
					(challengeIdNum !== 4 || m.ac11Approved === true),
			);

			const memberCountText = `${challengeMembers.length} thành viên`;
			const progressMemberCountEl = document.getElementById("progressMemberCount");
			const summaryMemberCountEl = document.getElementById("memberCountSummary");
			if (progressMemberCountEl) progressMemberCountEl.textContent = memberCountText;
			if (summaryMemberCountEl) summaryMemberCountEl.textContent = memberCountText;
		} catch (error) {
			console.error("Error updating member count:", error);
		}
	}

	function updateDisplayModeConfig() {
		const toggle = document.getElementById("displayModeToggle") as HTMLInputElement | null;
		const label = document.getElementById("toggleLabel");
		const leaderboard = document.getElementById("leaderboard");

		if (toggle) {
			// Toggle CHECKED (ON) = Username (discord), UNCHECKED (OFF) = Tên (name)
			toggle.checked = displayMode === "discord";
		}

		if (label) {
			label.textContent = displayMode === "discord" ? "Username" : "Tên";
			label.className =
				displayMode === "discord"
					? "ml-3 text-sm font-bold text-[#CC785C] w-20 text-center select-none transition-colors"
					: "ml-3 text-sm font-bold text-[#141413] w-20 text-center select-none transition-colors";
		}

		// Update CSS classes
		if (leaderboard) {
			leaderboard.classList.remove("show-name", "show-discord");
			if (displayMode === "name") {
				leaderboard.classList.add("show-name");
			} else {
				leaderboard.classList.add("show-discord");
			}
		}
	}

	async function loadLeaderboard(challengeId: string) {
		try {
			const loadingDiv = document.getElementById("loading");
			const leaderboardDiv = document.getElementById("leaderboard");
			const leaderboardDesktopBody = document.getElementById("leaderboardDesktopBody");
			const leaderboardCardsBody = document.getElementById(
				"leaderboardCardsBody",
			);

			if (loadingDiv) loadingDiv.classList.remove("hidden");
			if (leaderboardDiv) leaderboardDiv.classList.add("hidden");

			if (!usersData || !studyRecordsData) await loadStaticData(challengeId);

			if (!usersData || !usersData.data) {
				if (loadingDiv)
					loadingDiv.innerHTML =
						'<p class="text-red-500">Không tìm thấy dữ liệu</p>';
				return;
			}

			const members = usersData.data || [];
			const challengeIdNum = parseInt(challengeId);
			const challengeMembers = members.filter(
				(m: LeaderboardUser) =>
					!m.hidden &&
					m.challengeIds &&
					m.challengeIds.includes(challengeIdNum) &&
					(challengeIdNum !== 4 || m.ac11Approved === true),
			);

			updateMemberCount(challengeId);

			const membersWithStats: LeaderboardMember[] = challengeMembers.map((member: LeaderboardUser) => {
				const stats = calculateUserStatsForLeaderboard(
					member.id,
					challengeId,
				);
				return { ...member, ...stats };
			});

			membersWithStats.sort(
				(a, b) => b.disciplinePercentage - a.disciplinePercentage,
			);
			allMembersWithStats = membersWithStats;

			const filteredMembers = applySearchFilter(
				membersWithStats,
				currentSearchQuery,
			);

			if (loadingDiv) loadingDiv.classList.add("hidden");
			if (leaderboardDiv) leaderboardDiv.classList.remove("hidden");

			// Apply display mode classes immediately
			updateDisplayModeConfig();

			if (!leaderboardDesktopBody && !leaderboardCardsBody) return;

			if (filteredMembers.length === 0) {
				const emptyMessage = currentSearchQuery
					? `Không tìm thấy thành viên nào với từ khóa "${currentSearchQuery}"`
					: "Chưa có thành viên nào trong challenge này";
				if (leaderboardDesktopBody)
					leaderboardDesktopBody.innerHTML = `<div class="text-center text-[#8E8B82] py-12 text-base bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl shadow-xs">${emptyMessage}</div>`;
				if (leaderboardCardsBody)
					leaderboardCardsBody.innerHTML = `<div class="text-center text-[#8E8B82] py-12 text-base bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl shadow-xs">${emptyMessage}</div>`;
				return;
			}

			let currentRank = 1;
			allMembersWithStats.forEach((member: LeaderboardMember, index: number) => {
				if (
					index > 0 &&
					member.disciplinePercentage <
						allMembersWithStats[index - 1].disciplinePercentage
				) {
					currentRank = index + 1;
				}
				member.rank = currentRank;
			});

			// --- Claude style rendering helpers ---

			function getRankBadge(rank: number) {
				return String(rank || 0);
			}

			function getRankCircleClass(rank: number) {
				if (rank === 1)
					return "bg-[#FEF3C7] border-[#FDE68A] text-[#B45309]";
				if (rank === 2)
					return "bg-[#F1F5F9] border-[#CBD5E1] text-[#475569]";
				if (rank === 3)
					return "bg-[#FFEDD5] border-[#FED7AA] text-[#C2410C]";
				return "bg-[#F3EFEA] border-[#E6DFD8] text-[#6C6A64]";
			}

			function getDesktopCardClass(rank: number) {
				if (rank === 1)
					return "border-[#F59E0B]/50 bg-gradient-to-r from-[#FFFDF5] via-[#FFFFFF] to-[#FAF8F5] shadow-[0_4px_20px_rgba(245,158,11,0.06)]";
				if (rank === 2)
					return "border-[#CBD5E1] bg-gradient-to-r from-[#F8FAFC] via-[#FFFFFF] to-[#FAF8F5] shadow-xs";
				if (rank === 3)
					return "border-[#FDBA74] bg-gradient-to-r from-[#FFF8F0] via-[#FFFFFF] to-[#FAF8F5] shadow-xs";
				return "border-[#E6DFD8] bg-[#FFFFFF] shadow-xs";
			}

			function getTopRowClass(_rank: number) {
				return "";
			}

			// Render Desktop Blocks
			const loggedMemberIdStr = document.getElementById("leaderboard")?.dataset?.loggedMemberId;
			const loggedMemberId = loggedMemberIdStr ? parseInt(loggedMemberIdStr) : 0;

			if (leaderboardDesktopBody) {
				leaderboardDesktopBody.innerHTML = filteredMembers
					.map((member: LeaderboardMember) => {
						const memberRank = member.rank ?? 0;
						const rankBadge = getRankBadge(memberRank);
						const topCardClass = getTopRowClass(memberRank);
						const baseCardClass = getDesktopCardClass(memberRank);
						const isMyRow = loggedMemberId > 0 && member.id === loggedMemberId;
						const cardClass = isMyRow
							? "my-user-row border-[#CC785C] bg-[#FDF8F5] shadow-[0_0_24px_rgba(204,120,92,0.16)] ring-2 ring-[#CC785C]/40"
							: (topCardClass || baseCardClass);

						let disciplineColor = "text-[#CC785C]";
						let barColor = "bg-[#CC785C]";
						if (memberRank === 1) {
							disciplineColor = "text-[#D97706]";
							barColor = "bg-[#D97706]";
						} else if (member.disciplinePercentage < 50) {
							disciplineColor = "text-[#C64545]";
							barColor = "bg-[#C64545]";
						}

						const rankCircleClass = getRankCircleClass(memberRank);

						return `
						<a href="/profile/${member.id}" target="_blank" class="relative block rounded-2xl px-6 py-4.5 ${cardClass} transition-all duration-200 hover:border-[#CC785C]/50 hover:shadow-md overflow-hidden border">
							<div class="flex items-center gap-5">
								<div class="flex items-center justify-center w-12 h-12 rounded-xl border text-xl leading-none font-bold shrink-0 ${rankCircleClass}">${rankBadge}</div>
								<div class="min-w-0 w-[20rem] lg:w-[23rem]">
									<div class="flex items-center gap-2 overflow-hidden">
										<div class="font-bold text-xl leading-tight text-[#141413] truncate">${displayMode === "name" ? (member.name || "Không có tên") : (member.discordNickname || member.name || "Không có tên")}</div>
										${isMyRow ? '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#CC785C] text-white shadow-xs shrink-0">Bạn ⭐</span>' : ""}
										${member.role === "admin" ? '<span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider bg-[#CC785C]/10 text-[#CC785C] border border-[#CC785C]/25 shrink-0">Admin</span>' : ""}
									</div>
									<div class="text-xs text-[#8E8B82] font-mono mt-1 tracking-wide font-medium">${displayMode === "name" ? (member.discordNickname ? '@' + member.discordNickname : '--') : (member.name || '--')}</div>
								</div>
								<div class="flex-1 grid grid-cols-4 gap-4 items-center">
									<div class="text-center">
										<div class="text-[11px] text-[#8E8B82] uppercase font-bold mb-1 tracking-wider">Chuỗi</div>
										<div class="text-3xl font-bold ${memberRank === 1 ? "text-[#D97706]" : "text-[#CC785C]"} leading-none font-mono tabular-nums">${member.streak}</div>
									</div>
									<div class="text-center">
										<div class="text-[11px] text-[#8E8B82] uppercase font-bold mb-1 tracking-wider">Kỷ lục</div>
										<div class="text-2xl font-bold text-[#3D3D3A] leading-none font-mono tabular-nums">${member.longestStreak}</div>
									</div>
									<div class="text-center">
										<div class="text-[11px] text-[#8E8B82] uppercase font-bold mb-1 tracking-wider">Tổng ngày</div>
										<div class="text-2xl font-bold text-[#141413] leading-none font-mono tabular-nums">${member.totalDays}</div>
									</div>
									<div class="text-right pr-2">
										<div class="text-[11px] text-[#8E8B82] uppercase font-bold mb-1 tracking-wider">Kỷ luật</div>
										<div class="text-2xl leading-none font-bold ${disciplineColor} font-mono tabular-nums mb-2">${member.disciplinePercentage}%</div>
										<div class="w-24 lg:w-28 h-2 bg-[#EAE4DC] rounded-full overflow-hidden ml-auto">
											<div class="h-full ${barColor} rounded-full" style="width: ${member.disciplinePercentage}%"></div>
										</div>
									</div>
								</div>
							</div>
						</a>
					`;
					})
					.join("");
			}

			if (leaderboardCardsBody) {
				leaderboardCardsBody.innerHTML = filteredMembers
					.map((member: LeaderboardMember) => {
						const memberRank = member.rank ?? 0;
						const rankBadge = getRankBadge(memberRank);
						const baseCardClass = getDesktopCardClass(memberRank);
						const isMyRow = loggedMemberId > 0 && member.id === loggedMemberId;
						const cardClass = isMyRow
							? "my-user-row border-[#CC785C] bg-[#FDF8F5] shadow-[0_0_20px_rgba(204,120,92,0.16)] ring-2 ring-[#CC785C]/40"
							: baseCardClass;
						const rankCircleClass = getRankCircleClass(memberRank);

						let disciplineColor = "text-[#CC785C]";
						let barColor = "bg-[#CC785C]";
						if (memberRank === 1) {
							disciplineColor = "text-[#D97706]";
							barColor = "bg-[#D97706]";
						} else if (member.disciplinePercentage < 50) {
							disciplineColor = "text-[#C64545]";
							barColor = "bg-[#C64545]";
						}

						return `
						<a
							href="/profile/${member.id}"
							target="_blank"
							class="block rounded-2xl p-4 border ${cardClass} active:scale-[0.98] transition-all"
						>
							<div class="flex items-start justify-between gap-3 max-w-full">
								<div class="flex items-center gap-3 min-w-0">
									<div class="flex items-center justify-center w-11 h-11 rounded-xl border text-lg leading-none font-bold shrink-0 ${rankCircleClass}">
										${rankBadge}
									</div>
									<div class="min-w-0">
										<div class="font-bold text-base text-[#141413] leading-tight flex items-center gap-1.5 overflow-hidden">
											${displayMode === "name" ? (member.name || "Không có tên") : (member.discordNickname || member.name || "Không có tên")}
											${isMyRow ? '<span class="text-[9px] uppercase font-bold bg-[#CC785C] text-white px-1.5 py-0.5 rounded shrink-0 shadow-xs">Bạn ⭐</span>' : ""}
											${member.role === "admin" ? '<span class="text-[9px] uppercase font-bold bg-[#CC785C]/10 text-[#CC785C] px-1 py-0.5 rounded shrink-0 border border-[#CC785C]/25">Admin</span>' : ""}
										</div>
										<div class="text-xs text-[#8E8B82] font-mono mt-1">${displayMode === "name" ? (member.discordNickname ? '@' + member.discordNickname : '--') : (member.name || '--')}</div>
									</div>
								</div>
								<div class="text-right shrink-0">
									<div class="text-2xl font-bold ${memberRank === 1 ? "text-[#D97706]" : "text-[#CC785C]"} font-mono tabular-nums leading-none">${member.streak}</div>
									<div class="text-[10px] uppercase tracking-wider text-[#8E8B82] font-bold mt-1">Chuỗi</div>
								</div>
							</div>

							<div class="grid grid-cols-3 gap-2 py-2.5 border-t border-[#E6DFD8] mt-3">
								<div class="text-center">
									<div class="text-[10px] uppercase tracking-wider text-[#8E8B82] font-bold mb-0.5">Kỷ lục</div>
									<div class="font-bold text-[#3D3D3A] font-mono tabular-nums text-lg leading-none">${member.longestStreak}</div>
								</div>
								<div class="text-center border-l border-[#E6DFD8]">
									<div class="text-[10px] uppercase tracking-wider text-[#8E8B82] font-bold mb-0.5">Tổng ngày</div>
									<div class="font-bold text-[#141413] font-mono tabular-nums text-lg leading-none">${member.totalDays}</div>
								</div>
								<div class="text-center border-l border-[#E6DFD8]">
									<div class="text-[10px] uppercase tracking-wider text-[#8E8B82] font-bold mb-0.5">Kỷ luật</div>
									<div class="font-bold ${disciplineColor} font-mono tabular-nums text-lg leading-none">${member.disciplinePercentage}%</div>
								</div>
							</div>

							<div class="mt-1.5 w-full h-2 bg-[#EAE4DC] rounded-full overflow-hidden">
								<div class="h-full ${barColor} rounded-full" style="width: ${member.disciplinePercentage}%"></div>
							</div>
						</a>
					`;
					})
					.join("");
			}
		} catch (error: unknown) {
			console.error("Error loading leaderboard:", error);
			const loadingDiv = document.getElementById("loading");
			if (loadingDiv) {
				const errorMessage = error instanceof Error ? error.message : String(error);
				loadingDiv.innerHTML = `<p class="text-red-500">Lỗi: ${errorMessage}</p>`;
			}
		}
	}

	function applySearchFilter(members: LeaderboardMember[], searchQuery: string) {
		if (!searchQuery || searchQuery.trim() === "") return members;
		const query = searchQuery.trim().toLowerCase();
		return members.filter((member: LeaderboardMember) => {
			const id = String(member.id || "").toLowerCase();
			const name = (member.name || "").toLowerCase();
			const discord = (member.discordNickname || "").toLowerCase();
			return (
				id.includes(query) ||
				name.includes(query) ||
				discord.includes(query)
			);
		});
	}

	function renderFilteredLeaderboard() {
		loadLeaderboard(currentChallengeId);
	}

	const challengeSelect = document.getElementById("challengeSelect") as HTMLSelectElement | null;
	if (challengeSelect) {
		challengeSelect.addEventListener("change", async (e) => {
			const target = e.currentTarget as HTMLSelectElement | null;
			if (!target) return;
			currentChallengeId = target.value;
			currentSearchQuery = "";
			const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
			if (searchInput) searchInput.value = "";
			const clearSearchBtn = document.getElementById("clearSearch") as HTMLButtonElement | null;
			if (clearSearchBtn) {
				clearSearchBtn.classList.remove("opacity-100");
				clearSearchBtn.classList.add("opacity-0", "pointer-events-none");
			}
			leaderboardWindow.updateProgressBar?.(currentChallengeId);
			const titleEl = document.getElementById("challengeTitle");
			// Update title logic...
			if (titleEl) {
				const challengeName = challengesConfig[currentChallengeId]?.name || `Challenge ${currentChallengeId}`;
				titleEl.textContent = `${challengeName} - 100 ngày thử thách`;
			}
			
			await loadStaticData(currentChallengeId);
			updateMemberCount(currentChallengeId);
			loadLeaderboard(currentChallengeId);
		});
	}

	const searchInput = document.getElementById("searchInput") as HTMLInputElement | null;
	const clearSearchBtn = document.getElementById("clearSearch") as HTMLButtonElement | null;
	if (searchInput) {
		let searchTimeout: SearchTimer | undefined;
		searchInput.addEventListener("input", (e) => {
			clearTimeout(searchTimeout);
			const target = e.currentTarget as HTMLInputElement | null;
			currentSearchQuery = target?.value || "";
			if (clearSearchBtn) {
				if (currentSearchQuery.trim() !== "") {
					clearSearchBtn.classList.remove("opacity-0", "pointer-events-none");
					clearSearchBtn.classList.add("opacity-100");
				} else {
					clearSearchBtn.classList.remove("opacity-100");
					clearSearchBtn.classList.add("opacity-0", "pointer-events-none");
				}
			}
			searchTimeout = setTimeout(() => {
				renderFilteredLeaderboard();
			}, 300);
		});
	}

	if (clearSearchBtn) {
		clearSearchBtn.addEventListener("click", () => {
			currentSearchQuery = "";
			if (searchInput) {
				searchInput.value = "";
				searchInput.focus();
			}
			clearSearchBtn.classList.remove("opacity-100");
			clearSearchBtn.classList.add("opacity-0", "pointer-events-none");
			renderFilteredLeaderboard();
		});
	}

	const displayModeToggle = document.getElementById("displayModeToggle") as HTMLInputElement | null;

	function switchDisplayMode(isUsernameMode: boolean) {
		displayMode = isUsernameMode ? "discord" : "name";
		localStorage.setItem("leaderboardDisplayMode", displayMode);
		updateDisplayModeConfig();
		renderFilteredLeaderboard();
	}

	if (displayModeToggle) {
		displayModeToggle.addEventListener("change", (e) => {
			const target = e.currentTarget as HTMLInputElement | null;
			switchDisplayMode(Boolean(target?.checked));
		});
	}

	// Initial styling (without waiting for JS)
	updateDisplayModeConfig();

	// Scroll to my position button event listener (Phase 4)
	document.getElementById("scrollToMyRowBtn")?.addEventListener("click", () => {
		const myRows = Array.from(document.querySelectorAll(".my-user-row")) as HTMLElement[];
		const visibleRow = myRows.find((el) => el.offsetParent !== null || el.getBoundingClientRect().height > 0);
		if (visibleRow) {
			visibleRow.scrollIntoView({ behavior: "smooth", block: "center" });
		}
	});



	if ("requestIdleCallback" in window) {
		requestIdleCallback(
			async () => {
				await loadStaticData(currentChallengeId);
				updateMemberCount(currentChallengeId);
				loadLeaderboard(currentChallengeId);
			},
			{ timeout: 1000 },
		);
	} else {
		setTimeout(async () => {
			await loadStaticData(currentChallengeId);
			updateMemberCount(currentChallengeId);
			loadLeaderboard(currentChallengeId);
		}, 0);
	}
</script>
