---
import Layout from "../layouts/Layout.astro";
import { verifySession } from "../utils/session";
import { getUserByDiscordId } from "../utils/db";
import { getFromKV } from "../utils/kv";

// Đọc phiên người dùng
const sessionCookie = Astro.cookies.get('user_session')?.value;
let user: {
  id: string;
  username: string;
  displayName: string;
  avatar: string;
  email?: string | null;
  inGuild?: boolean;
  memberId?: number | null;
  memberName?: string | null;
} | null = null;

let existingProfile: any = null;

if (sessionCookie) {
  const env = (Astro.locals as any).runtime?.env ?? {};
  const sessionSecret = env.SESSION_SECRET || import.meta.env.SESSION_SECRET || 'anki_challenge_secret_key_2026_super_secure';
  user = await verifySession<typeof user>(sessionCookie, sessionSecret) ?? null;

  if (user?.id) {
    try {
      if (env.DB) {
        existingProfile = await getUserByDiscordId(env.DB, user.id);
      } else {
        const usersData = await getFromKV<any>(env, 'users', Astro.url.origin);
        const list = Array.isArray(usersData?.data) ? usersData.data : (Array.isArray(usersData) ? usersData : []);
        existingProfile = list.find((u: any) => String(u.discordId) === String(user!.id)) || null;
      }
    } catch (e) {
      console.warn('[AC11 Register Profile Lookup]', e);
    }
  }
}

const DISCORD_INVITE_URL = "https://discord.com/invite/867268399687663616";
const REGISTRATION_OPEN_ISO = "2026-08-22T00:00:00+07:00";
const REGISTRATION_OPEN_TIMESTAMP = new Date(REGISTRATION_OPEN_ISO).getTime();
const isRegistrationOpen = Date.now() >= REGISTRATION_OPEN_TIMESTAMP;
---

<Layout title="Đăng ký Anki Challenge 11 (Private)">
  <main class="min-h-screen relative overflow-x-hidden text-slate-100 py-10 px-4">
    <!-- Ambient glowing backgrounds -->
    <div class="fixed top-[-10%] left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-purple-500/10 blur-[130px] rounded-full pointer-events-none z-0"></div>
    <div class="fixed bottom-[-10%] right-[-5%] w-[500px] h-[500px] bg-cyan-500/10 blur-[150px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-3xl mx-auto relative z-10">
      
      <!-- Top Navigation / Back Link -->
      <div class="flex items-center justify-between mb-8">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors bg-white/5 hover:bg-white/10 px-3.5 py-2 rounded-xl border border-white/10 backdrop-blur-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Bảng xếp hạng
        </a>

        {user && (
          <div class="flex items-center gap-3 bg-zinc-900/80 border border-white/10 px-3 py-1.5 rounded-xl backdrop-blur-md">
            <img src={user.avatar} alt={user.displayName} class="w-6 h-6 rounded-full border border-cyan-400/40 object-cover" />
            <span class="text-xs font-bold text-slate-200">@{user.username}</span>
            <a href="/logout" class="text-[11px] text-red-400 hover:underline ml-1 font-semibold">Đăng xuất</a>
          </div>
        )}
      </div>

      <!-- Header Hero -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-500/20 via-indigo-500/20 to-cyan-500/20 border border-purple-400/40 text-purple-300 px-4 py-1.5 rounded-full text-xs md:text-sm font-bold tracking-wide uppercase mb-3 shadow-lg shadow-purple-500/10">
          🔒 Anki Challenge 11 • Link Đăng Ký Nội Bộ
        </div>
        <h1 class="text-3xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-white via-purple-100 to-cyan-400 pb-2">
          Đăng Ký Anki Challenge 11
        </h1>
        <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto mt-1">
          Biểu mẫu đăng ký sớm danh riêng cho thành viên nội bộ Anki Việt Nam chuẩn bị cho mùa thử thách tiếp theo.
        </p>
      </div>

      <!-- BANNER ĐẾM NGƯỢC THỜI GIAN MỞ ĐĂNG KÝ (22/08/2026) -->
      <div id="countdownBanner" class="mb-8 p-6 md:p-8 rounded-3xl bg-gradient-to-br from-purple-500/15 via-zinc-900/90 to-indigo-950/80 border-2 border-purple-500/30 backdrop-blur-xl shadow-2xl relative overflow-hidden">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 relative z-10 text-center md:text-left">
          <div class="max-w-md">
            <div class="inline-flex items-center gap-2 bg-purple-500/20 text-purple-300 border border-purple-500/40 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase mb-2">
              <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
              Chưa mở cổng đăng ký
            </div>
            <h2 class="text-xl md:text-2xl font-black text-white">
              Cổng đăng ký sẽ mở vào ngày 22/08/2026
            </h2>
            <p class="text-slate-300 text-xs md:text-sm mt-1.5 leading-relaxed">
              {user && user.inGuild 
                ? `Tài khoản @${user.username} đã xác thực thành viên Discord Anki VN thành công! Bạn đã sẵn sàng, nút đăng ký sẽ tự động mở khi đến thời điểm.`
                : "Thành viên có thể đăng nhập Discord và tham gia máy chủ Anki Việt Nam trước để sẵn sàng đăng ký ngay khi cổng mở."}
            </p>
          </div>

          <!-- Countdown Digits -->
          <div class="flex items-center gap-2.5 sm:gap-3 shrink-0" id="countdownTimerContainer">
            <div class="flex flex-col items-center bg-zinc-950/80 border border-purple-500/20 rounded-2xl px-3 py-2.5 min-w-[62px] shadow-inner">
              <span id="cdDays" class="text-2xl sm:text-3xl font-black text-purple-400 font-mono">00</span>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Ngày</span>
            </div>
            <span class="text-xl font-bold text-slate-600">:</span>
            <div class="flex flex-col items-center bg-zinc-950/80 border border-purple-500/20 rounded-2xl px-3 py-2.5 min-w-[62px] shadow-inner">
              <span id="cdHours" class="text-2xl sm:text-3xl font-black text-white font-mono">00</span>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Giờ</span>
            </div>
            <span class="text-xl font-bold text-slate-600">:</span>
            <div class="flex flex-col items-center bg-zinc-950/80 border border-purple-500/20 rounded-2xl px-3 py-2.5 min-w-[62px] shadow-inner">
              <span id="cdMins" class="text-2xl sm:text-3xl font-black text-white font-mono">00</span>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Phút</span>
            </div>
            <span class="text-xl font-bold text-slate-600">:</span>
            <div class="flex flex-col items-center bg-zinc-950/80 border border-purple-500/20 rounded-2xl px-3 py-2.5 min-w-[62px] shadow-inner">
              <span id="cdSecs" class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono">00</span>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Giây</span>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 1: CHƯA ĐĂNG NHẬP DISCORD -->
      {!user && (
        <div class="bg-gradient-to-b from-zinc-900/90 to-zinc-950/90 border-2 border-indigo-500/30 rounded-3xl p-6 md:p-10 shadow-2xl backdrop-blur-xl text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-[#5865F2]/20 border border-[#5865F2]/40 flex items-center justify-center text-[#5865F2] shadow-lg shadow-[#5865F2]/20">
            <svg class="w-9 h-9 fill-current" viewBox="0 0 127.14 96.36">
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.68,1.76,1.36,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-20.95-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.92,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.2,45.92,96.07,53,91,65.69,84.69,65.69Z"/>
            </svg>
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-white mb-2">Bước 1: Đăng nhập Discord</h2>
          <p class="text-slate-300 text-sm md:text-base max-w-md mx-auto mb-6 leading-relaxed">
            Vui lòng đăng nhập Discord để hệ thống xác thực tư cách thành viên và cấp quyền truy cập biểu mẫu Anki Challenge 11.
          </p>

          <a
            href="/login?returnTo=/anki-challenge-11"
            class="inline-flex items-center gap-3 bg-[#5865F2] hover:bg-[#4752C4] active:scale-95 text-white font-bold px-7 py-3.5 rounded-2xl shadow-xl shadow-[#5865F2]/30 border border-indigo-300/40 text-base transition-all duration-200 cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 127.14 96.36">
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.68,1.76,1.36,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-20.95-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.92,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.2,45.92,96.07,53,91,65.69,84.69,65.69Z"/>
            </svg>
            <span>Đăng nhập bằng Discord</span>
          </a>
        </div>
      )}

      <!-- STEP 2: ĐÃ ĐĂNG NHẬP NHƯNG CHƯA VÀO GUILD DISCORD ANKI VN -->
      {user && !user.inGuild && (
        <div id="notInGuildCard" class="bg-gradient-to-b from-zinc-900/90 to-zinc-950/90 border-2 border-amber-500/40 rounded-3xl p-6 md:p-10 shadow-2xl backdrop-blur-xl text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full overflow-hidden border-2 border-amber-400/60 shadow-lg shadow-amber-500/20">
            <img src={user.avatar} alt={user.displayName} class="w-full h-full object-cover" />
          </div>

          <div class="inline-flex items-center gap-2 bg-amber-500/10 text-amber-300 border border-amber-500/30 px-3 py-1 rounded-full text-xs font-semibold mb-3">
            ⚠️ Yêu cầu thành viên máy chủ
          </div>

          <h2 class="text-xl md:text-2xl font-bold text-white mb-2">
            Chào {user.displayName}! Bạn cần tham gia Discord Anki Việt Nam
          </h2>
          <p class="text-slate-300 text-sm md:text-base max-w-lg mx-auto mb-6 leading-relaxed">
            Thử thách Anki Challenge 11 chỉ áp dụng cho thành viên máy chủ Discord <strong>Anki Việt Nam</strong>. Bạn hãy tham gia máy chủ trước, sau đó bấm <strong>"Kiểm tra lại"</strong> nhé!
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-md mx-auto">
            <a
              href={DISCORD_INVITE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#5865F2] hover:bg-[#4752C4] text-white font-bold px-6 py-3 rounded-2xl shadow-lg shadow-[#5865F2]/25 border border-indigo-400/30 text-sm transition-all"
            >
              <span>Tham gia Discord Anki VN ↗</span>
            </a>

            <button
              id="recheckGuildBtn"
              type="button"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-2xl shadow-lg shadow-emerald-600/25 border border-emerald-400/40 text-sm transition-all cursor-pointer"
            >
              <svg id="recheckIcon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001,0,004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003,0,01-15.357-2m15.357 2H15" />
              </svg>
              <span>Kiểm tra lại</span>
            </button>
          </div>
        </div>
      )}

      <!-- STEP 3: FORM ĐĂNG KÝ (KHI ĐÃ ĐỦ ĐIỀU KIỆN) -->
      <div id="registrationFormContainer" class={user && user.inGuild ? "block" : "hidden"}>
        
        <!-- Discord Verified Badge -->
        {user && (
          <div class="mb-6 p-4 rounded-2xl bg-purple-950/40 border border-purple-500/30 backdrop-blur-md flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="relative">
                <img src={user.avatar} alt={user.displayName} class="w-10 h-10 rounded-full border border-purple-400/50 object-cover" />
                <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-400 border-2 border-zinc-900 rounded-full"></span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold text-white">{user.displayName}</span>
                  <span class="text-[11px] bg-purple-500/20 text-purple-300 font-semibold px-2 py-0.5 rounded-full border border-purple-500/30">✓ Đã xác thực AC11</span>
                </div>
                <div class="text-xs text-slate-400 font-mono">@{user.username} • ID: {user.id}</div>
              </div>
            </div>

            <div class="text-right hidden sm:block">
              <span class="text-xs text-slate-400">Email xác nhận</span>
              <div class="text-xs font-semibold text-slate-200">{user.email || 'Chưa cung cấp'}</div>
            </div>
          </div>
        )}

        <!-- Main Form Card -->
        <div class="bg-gradient-to-b from-zinc-900/95 to-zinc-950/95 border border-purple-500/20 rounded-3xl p-6 md:p-10 shadow-2xl backdrop-blur-xl">
          <form id="registrationForm" class="space-y-6">
            
            <!-- Challenge ID 4 (Anki Challenge 11) -->
            <input type="hidden" name="challengeId" value="4" />

            <!-- Họ và Tên -->
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Họ và Tên hiển thị <span class="text-red-400">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                value={existingProfile?.name || user?.displayName || user?.username || ''}
                placeholder="Ví dụ: Lê Hoàng Phúc"
                class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
              />
              <p class="text-[11px] text-slate-400 mt-1.5">Tên hiển thị trên Bảng xếp hạng Anki Challenge 11.</p>
            </div>

            <!-- Grid 2 cột: Năm sinh & Nơi ở -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="birthYear" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Năm sinh
                </label>
                <input
                  type="number"
                  id="birthYear"
                  name="birthYear"
                  min="1950"
                  max="2030"
                  value={existingProfile?.birthYear || ''}
                  placeholder="Ví dụ: 2001"
                  class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
                />
              </div>

              <div>
                <label for="place" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Tỉnh / Thành phố / Quốc gia
                </label>
                <input
                  type="text"
                  id="place"
                  name="place"
                  value={existingProfile?.place || ''}
                  placeholder="Ví dụ: Hà Nội, TP.HCM, Tokyo..."
                  class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
                />
              </div>
            </div>

            <!-- Grid 2 cột: Chuyên ngành & Kiến thức học -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="major" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Nghề nghiệp / Chuyên ngành
                </label>
                <input
                  type="text"
                  id="major"
                  name="major"
                  value={existingProfile?.major || ''}
                  placeholder="Ví dụ: Y khoa, Kỹ sư phần mềm..."
                  class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
                />
              </div>

              <div>
                <label for="learning" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                  Kiến thức / Ngoại ngữ muốn học
                </label>
                <input
                  type="text"
                  id="learning"
                  name="learning"
                  value={existingProfile?.learning || ''}
                  placeholder="Ví dụ: Tiếng Anh IELTS, Tiếng Trung HSK..."
                  class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
                />
              </div>
            </div>

            <!-- Mục tiêu thử thách -->
            <div>
              <label for="goals" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Mục tiêu trong mùa 11
              </label>
              <textarea
                id="goals"
                name="goals"
                rows="3"
                placeholder="Ví dụ: Duy trì 100 ngày không bỏ lỡ ngày nào, ôn tập 100 thẻ mỗi ngày..."
                class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all resize-none"
              >{existingProfile?.goals || ''}</textarea>
            </div>

            <!-- Trích dẫn / Lời hứa kỷ luật -->
            <div>
              <label for="quotes" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
                Châm ngôn / Lời hứa kỷ luật
              </label>
              <input
                type="text"
                id="quotes"
                name="quotes"
                value={existingProfile?.quotes || ''}
                placeholder="Ví dụ: Không có áp lực, không có kim cương"
                class="w-full bg-white/5 border border-white/10 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/30 rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 outline-none transition-all"
              />
            </div>

            <!-- Cam kết hoàn thành -->
            <div class="p-4 rounded-2xl bg-purple-950/30 border border-purple-500/30">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  name="commitment"
                  id="commitmentCheck"
                  required
                  class="mt-1 w-4 h-4 rounded text-purple-500 focus:ring-purple-400/50 bg-zinc-800 border-zinc-700"
                />
                <span class="text-xs sm:text-sm text-slate-200 leading-relaxed font-medium">
                  Tôi cam kết tham gia nghiêm túc mùa thử thách Anki Challenge 11, học bài đều đặn mỗi ngày và điểm danh qua bot Discord. <span class="text-red-400">*</span>
                </span>
              </label>
            </div>

            <!-- Notice if registration is locked -->
            {!isRegistrationOpen && (
              <div id="lockedFormNotice" class="p-4 rounded-2xl bg-purple-500/15 border border-purple-500/30 flex items-start gap-3">
                <span class="text-purple-400 text-lg shrink-0">⏳</span>
                <div class="text-xs sm:text-sm text-purple-200/90 leading-relaxed">
                  <strong>Cổng đăng ký chưa mở:</strong> Biểu mẫu Anki Challenge 11 sẽ chính thức tiếp nhận đăng ký vào ngày <strong>22/08/2026 lúc 00:00 (GMT+7)</strong>. Bạn có thể kiểm tra trước các thông tin và chuẩn bị sẵn sàng, nút đăng ký sẽ tự động mở khi đến giờ!
                </div>
              </div>
            )}

            <!-- Error message container -->
            <div id="formErrorMsg" class="hidden p-3.5 rounded-xl bg-red-950/60 border border-red-500/40 text-red-300 text-xs font-medium"></div>

            <!-- Submit Button -->
            <div class="pt-2">
              <button
                type="submit"
                id="submitBtn"
                disabled={!isRegistrationOpen}
                class={`w-full py-4 px-6 rounded-2xl font-black text-sm md:text-base uppercase tracking-wider shadow-xl transition-all flex items-center justify-center gap-2 ${
                  isRegistrationOpen
                    ? "bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white shadow-purple-500/25 hover:shadow-purple-500/35 active:scale-[0.99] cursor-pointer"
                    : "bg-zinc-800 border border-purple-500/30 text-purple-300 cursor-not-allowed opacity-90 shadow-purple-500/10"
                }`}
              >
                <span id="submitBtnText">{isRegistrationOpen ? "Gửi Đăng Ký Anki Challenge 11 🚀" : "⏳ Chưa mở hạn đăng ký (Mở ngày 22/08/2026)"}</span>
                <svg id="submitLoadingSpinner" class="hidden animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

          </form>
        </div>

      </div>

      <!-- SUCCESS MODAL / CARD -->
      <div id="successCard" class="hidden bg-gradient-to-b from-zinc-900/95 to-zinc-950/95 border-2 border-purple-500/40 rounded-3xl p-8 md:p-12 shadow-2xl backdrop-blur-xl text-center">
        <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-purple-500/20 border-2 border-purple-400/60 flex items-center justify-center text-purple-400 text-4xl shadow-xl shadow-purple-500/30">
          🎉
        </div>
        <h2 class="text-2xl md:text-3xl font-black text-white mb-2">Đăng Ký AC11 Thành Công!</h2>
        <p class="text-slate-300 text-sm md:text-base max-w-md mx-auto mb-8 leading-relaxed">
          Bạn đã đăng ký trước thành công cho <strong>Anki Challenge 11</strong>. Thông tin đã được ghi nhận vào hệ thống.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-md mx-auto">
          <a
            id="successProfileLink"
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-purple-500 hover:bg-purple-400 text-white font-bold px-6 py-3.5 rounded-2xl shadow-lg shadow-purple-500/25 text-sm transition-all"
          >
            👤 Xem Hồ sơ của bạn
          </a>
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold px-6 py-3.5 rounded-2xl border border-white/10 text-sm transition-all"
          >
            📊 Về Bảng xếp hạng
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  // Thời gian mở đăng ký: 22/08/2026 00:00:00 GMT+7
  const TARGET_OPEN_TIME = new Date("2026-08-22T00:00:00+07:00").getTime();

  const cdDays = document.getElementById("cdDays");
  const cdHours = document.getElementById("cdHours");
  const cdMins = document.getElementById("cdMins");
  const cdSecs = document.getElementById("cdSecs");
  const countdownBanner = document.getElementById("countdownBanner");
  const lockedFormNotice = document.getElementById("lockedFormNotice");

  function updateCountdown() {
    const now = Date.now();
    const diff = TARGET_OPEN_TIME - now;

    if (diff <= 0) {
      if (cdDays) cdDays.textContent = "00";
      if (cdHours) cdHours.textContent = "00";
      if (cdMins) cdMins.textContent = "00";
      if (cdSecs) cdSecs.textContent = "00";

      if (lockedFormNotice) lockedFormNotice.classList.add("hidden");
      if (submitBtn && submitBtn.disabled) {
        submitBtn.disabled = false;
        submitBtn.className = "w-full py-4 px-6 rounded-2xl font-black text-sm md:text-base uppercase tracking-wider shadow-xl transition-all flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white shadow-purple-500/25 hover:shadow-purple-500/35 active:scale-[0.99] cursor-pointer";
        if (submitBtnText) submitBtnText.textContent = "Gửi Đăng Ký Anki Challenge 11 🚀";
      }
      return;
    }

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    if (cdDays) cdDays.textContent = String(days).padStart(2, "0");
    if (cdHours) cdHours.textContent = String(hours).padStart(2, "0");
    if (cdMins) cdMins.textContent = String(minutes).padStart(2, "0");
    if (cdSecs) cdSecs.textContent = String(seconds).padStart(2, "0");
  }

  updateCountdown();
  const cdInterval = setInterval(updateCountdown, 1000);

  // Client-side interactions
  const recheckBtn = document.getElementById("recheckGuildBtn");
  const form = document.getElementById("registrationForm") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
  const submitBtnText = document.getElementById("submitBtnText");
  const submitLoadingSpinner = document.getElementById("submitLoadingSpinner");
  const formErrorMsg = document.getElementById("formErrorMsg");
  const successCard = document.getElementById("successCard");
  const registrationFormContainer = document.getElementById("registrationFormContainer");
  const notInGuildCard = document.getElementById("notInGuildCard");
  const successProfileLink = document.getElementById("successProfileLink") as HTMLAnchorElement | null;

  if (recheckBtn) {
    recheckBtn.addEventListener("click", async () => {
      const originalText = recheckBtn.innerHTML;
      recheckBtn.disabled = true;
      recheckBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Đang kiểm tra...</span>
      `;

      try {
        const res = await fetch("/api/auth/check-guild");
        const data = await res.json();

        if (data.authenticated && data.inGuild) {
          window.location.reload();
        } else {
          alert("Hệ thống vẫn chưa tìm thấy bạn trong máy chủ Discord Anki Việt Nam. Hãy chắc chắn bạn đã nhấn vào link tham gia máy chủ nhé!");
          recheckBtn.disabled = false;
          recheckBtn.innerHTML = originalText;
        }
      } catch (err) {
        alert("Có lỗi khi kiểm tra. Vui lòng thử lại!");
        recheckBtn.disabled = false;
        recheckBtn.innerHTML = originalText;
      }
    });
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (formErrorMsg) {
        formErrorMsg.classList.add("hidden");
        formErrorMsg.textContent = "";
      }

      if (submitBtn && submitBtnText && submitLoadingSpinner) {
        submitBtn.disabled = true;
        submitBtnText.textContent = "Đang xử lý...";
        submitLoadingSpinner.classList.remove("hidden");
      }

      const formData = new FormData(form);

      try {
        const res = await fetch("/api/register", {
          method: "POST",
          body: formData,
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.error || "Đăng ký thất bại. Vui lòng thử lại!");
        }

        if (registrationFormContainer) registrationFormContainer.classList.add("hidden");
        if (notInGuildCard) notInGuildCard.classList.add("hidden");
        if (successCard) successCard.classList.remove("hidden");

        if (successProfileLink && result.user?.id) {
          successProfileLink.href = `/profile/${result.user.id}`;
        }
      } catch (err: any) {
        if (formErrorMsg) {
          formErrorMsg.textContent = err.message || "Đã xảy ra lỗi khi gửi form.";
          formErrorMsg.classList.remove("hidden");
        }
      } finally {
        if (submitBtn && submitBtnText && submitLoadingSpinner) {
          submitBtn.disabled = false;
          submitBtnText.textContent = "Gửi Đăng Ký Anki Challenge 11 🚀";
          submitLoadingSpinner.classList.add("hidden");
        }
      }
    });
  }
</script>
