---
import Layout from "../layouts/Layout.astro";
import { verifySession } from "../utils/session";
import { getUserByDiscordId } from "../utils/db";
import { getFromKV } from "../utils/kv";

// Đọc phiên người dùng
const sessionCookie = Astro.cookies.get('user_session')?.value;
let user: {
  id: string;
  username: string;
  displayName: string;
  avatar: string;
  email?: string | null;
  inGuild?: boolean;
  memberId?: number | null;
  memberName?: string | null;
} | null = null;

let existingProfile: any = null;

if (sessionCookie) {
  const env = (Astro.locals as any).runtime?.env ?? {};
  const sessionSecret = env.SESSION_SECRET || import.meta.env.SESSION_SECRET || 'anki_challenge_secret_key_2026_super_secure';
  user = await verifySession<typeof user>(sessionCookie, sessionSecret) ?? null;

  if (user?.id) {
    try {
      if (env.DB) {
        existingProfile = await getUserByDiscordId(env.DB, user.id);
      } else {
        const usersData = await getFromKV<any>(env, 'users', Astro.url.origin);
        const list = Array.isArray(usersData?.data) ? usersData.data : (Array.isArray(usersData) ? usersData : []);
        existingProfile = list.find((u: any) => String(u.discordId) === String(user!.id)) || null;
      }
    } catch (e) {
      console.warn('[AC11 Register Profile Lookup]', e);
    }
  }
}

const DISCORD_INVITE_URL = "https://discord.gg/P5EwPm7C38";
const REGISTRATION_OPEN_ISO = "2026-08-22T00:00:00+07:00";
const REGISTRATION_OPEN_TIMESTAMP = new Date(REGISTRATION_OPEN_ISO).getTime();
const isRegistrationOpen = Date.now() >= REGISTRATION_OPEN_TIMESTAMP;
const isAlreadyRegistered = existingProfile?.challengeIds?.some((id: any) => Number(id) === 4) || false;
---

<Layout title="Đăng ký Anki Challenge 11 — Anki Việt Nam">
  <main class="min-h-screen bg-[#FAF9F5] text-[#141413] py-12 px-4 font-['Plus_Jakarta_Sans','Inter',sans-serif] selection:bg-[#CC785C]/20 selection:text-[#141413]">
    <div class="max-w-[700px] mx-auto">
      
      <!-- Top Navigation -->
      <div class="flex items-center justify-between mb-10 pb-4 border-b border-[#E6DFD8]">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-xs font-medium text-[#6B6860] hover:text-[#141413] bg-[#F3EFEA] hover:bg-[#EDE7DF] px-3.5 py-1.5 rounded-full border border-[#E6DFD8] transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Bảng xếp hạng
        </a>

        {user && (
          <div class="flex items-center gap-2.5 bg-[#F3EFEA] border border-[#E6DFD8] px-3 py-1 rounded-full">
            <img src={user.avatar} alt={user.displayName} class="w-5 h-5 rounded-full border border-[#D9D0C5] object-cover" />
            <span class="text-xs font-medium text-[#141413]">@{user.username}</span>
            <span class="text-[#9C948A] text-xs">·</span>
            <a href="/logout" class="text-xs text-[#6B6860] hover:text-[#CC785C] transition-colors font-medium">Đăng xuất</a>
          </div>
        )}
      </div>

      <!-- Header Hero (Claude Editorial Style) -->
      <div class="text-center mb-10">
        <div class="inline-flex items-center gap-1.5 bg-[#F3EFEA] border border-[#E6DFD8] text-[#6B6860] px-3 py-1 rounded-full text-xs font-medium mb-3">
          <span class="text-[#CC785C]">📋</span>
          <span>Anki Challenge 11</span>
          <span class="text-[#9C948A]">·</span>
          <span>Đăng Ký Tham Gia</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-normal font-['Newsreader','EB_Garamond',serif] italic text-[#141413] tracking-tight mb-3">
          Đăng ký Anki Challenge 11
        </h1>
        <p class="text-[#6B6860] text-sm sm:text-base max-w-md mx-auto leading-relaxed">
          Đăng ký tham gia thử thách Anki Challenge 11 — 100 ngày kỷ luật học tập, bắt đầu từ 01/09/2026.
        </p>
      </div>

      <!-- ĐÃ ĐĂNG KÝ AC11 → hiển thị thay vì form -->
      {isAlreadyRegistered && (
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-8 sm:p-12 text-center shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#E7F1EA] border border-[#CBE0D2] flex items-center justify-center text-[#437A55]">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
          </div>
          <h2 class="text-2xl font-normal font-['Newsreader','EB_Garamond',serif] text-[#141413] mb-2">
            Bạn đã đăng ký Anki Challenge 11
          </h2>
          <p class="text-[#6B6860] text-sm max-w-md mx-auto mb-6 leading-relaxed">
            Bạn đã đăng ký tham gia Anki Challenge 11. Thông tin của bạn đã được ghi nhận. Chúc bạn 100 ngày kỷ luật!
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href="/" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#CC785C] hover:bg-[#B8684E] text-white font-medium px-6 py-2.5 rounded-full text-xs transition-all shadow-sm">
              <span>Xem Bảng xếp hạng</span>
            </a>
            {existingProfile?.id && (
              <a href={`/profile/${existingProfile.id}`} class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#F3EFEA] hover:bg-[#EDE7DF] text-[#141413] font-medium px-6 py-2.5 rounded-full border border-[#E6DFD8] text-xs transition-all">
                <span>Trang cá nhân</span>
              </a>
            )}
          </div>
        </div>
      )}

      <!-- STEP 1: CHƯA ĐĂNG NHẬP DISCORD (Claude Dark Contrast Card) -->
      {!isAlreadyRegistered && !user && (
        <div class="bg-[#181715] text-[#FAF9F5] border border-[#2B2926] rounded-2xl p-8 sm:p-10 text-center mb-8 shadow-sm">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-[#2B2926] flex items-center justify-center text-[#FAF9F5]">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 127.14 96.36">
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.68,1.76,1.36,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-20.95-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.92,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.2,45.92,96.07,53,91,65.69,84.69,65.69Z"/>
            </svg>
          </div>

          <h2 class="text-xl font-normal font-['Newsreader','EB_Garamond',serif] text-[#FAF9F5] mb-2">Bước 1: Đăng nhập Discord</h2>
          <p class="text-[#A8A49C] text-xs sm:text-sm max-w-md mx-auto mb-6 leading-relaxed">
            Vui lòng đăng nhập Discord để hệ thống xác thực tư cách thành viên và cấp quyền truy cập biểu mẫu Anki Challenge 11.
          </p>

          <a
            href="/login?returnTo=/anki-challenge-11"
            class="inline-flex items-center gap-2.5 bg-[#CC785C] hover:bg-[#B8684E] text-white font-medium px-6 py-3 rounded-full text-sm transition-all active:scale-[0.99] cursor-pointer shadow-sm"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 127.14 96.36">
              <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.68,1.76,1.36,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1,105.25,105.25,0,0,0,32.19-16.14c2.64-27.38-4.51-51.11-20.95-72.15ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.92,53.87,53,48.8,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.2,45.92,96.07,53,91,65.69,84.69,65.69Z"/>
            </svg>
            <span>Đăng nhập bằng Discord</span>
          </a>
        </div>
      )}

      <!-- STEP 2: ĐÃ ĐĂNG NHẬP NHƯNG CHƯA VÀO GUILD DISCORD ANKI VN -->
      {!isAlreadyRegistered && user && !user.inGuild && (
        <div id="notInGuildCard" class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-7 sm:p-9 text-center mb-8 shadow-sm">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full overflow-hidden border border-[#E6DFD8]">
            <img src={user.avatar} alt={user.displayName} class="w-full h-full object-cover" />
          </div>

          <div class="inline-flex items-center gap-1.5 bg-[#F3EFEA] text-[#6B6860] border border-[#E6DFD8] px-2.5 py-0.5 rounded-full text-xs font-medium mb-3">
            <span>Yêu cầu máy chủ Discord</span>
          </div>

          <h2 class="text-lg font-normal font-['Newsreader','EB_Garamond',serif] text-[#141413] mb-1.5">
            Chào {user.displayName}! Bạn cần tham gia Discord Anki Việt Nam
          </h2>
          <p class="text-[#6B6860] text-xs sm:text-sm max-w-md mx-auto mb-5 leading-relaxed">
            Thử thách Anki Challenge 11 chỉ áp dụng cho thành viên máy chủ Discord <strong>Anki Việt Nam</strong>. Bạn hãy tham gia máy chủ trước, sau đó bấm <strong>"Kiểm tra lại"</strong> nhé!
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-sm mx-auto">
            <a
              href={DISCORD_INVITE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#181715] hover:bg-[#2B2926] text-white font-medium px-5 py-2.5 rounded-full text-xs transition-all"
            >
              <span>Tham gia Discord Anki VN ↗</span>
            </a>

            <button
              id="recheckGuildBtn"
              type="button"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#F3EFEA] hover:bg-[#EDE7DF] text-[#141413] font-medium px-5 py-2.5 rounded-full border border-[#E6DFD8] text-xs transition-all cursor-pointer"
            >
              <svg id="recheckIcon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001,0,004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003,0,01-15.357-2m15.357 2H15" />
              </svg>
              <span>Kiểm tra lại</span>
            </button>
          </div>
        </div>
      )}

      <!-- STEP 3: FORM ĐĂNG KÝ (KHI ĐÃ ĐỦ ĐIỀU KIỆN) -->
      <div id="registrationFormContainer" class={user && user.inGuild && !isAlreadyRegistered ? "block" : "hidden"}>
        
        <!-- Discord Verified Badge (Claude Clean Card) -->
        {user && (
          <div class="mb-6 p-4 rounded-xl bg-[#F6F4EE] border border-[#E6DFD8] flex items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="relative">
                <img src={user.avatar} alt={user.displayName} class="w-9 h-9 rounded-full border border-[#E6DFD8] object-cover" />
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-[#437A55] border-2 border-white rounded-full"></span>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-semibold text-[#141413]">{user.displayName}</span>
                  <span class="text-[10px] bg-white text-[#437A55] font-medium px-2 py-0.5 rounded-full border border-[#E6DFD8]">✓ Xác thực AC11</span>
                </div>
                <div class="text-[11px] text-[#6B6860] font-mono">@{user.username} · ID: {user.id}</div>
              </div>
            </div>

            <div class="text-right hidden sm:block">
              <span class="text-[11px] text-[#9C948A]">Email</span>
              <div class="text-xs font-medium text-[#141413]">{user.email || 'Chưa cung cấp'}</div>
            </div>
          </div>
        )}

        <!-- Main Form Card (Claude Refined Card) -->
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-6 sm:p-8 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <form id="registrationForm" class="space-y-5">
            
            <!-- Challenge ID 4 (Anki Challenge 11) -->
            <input type="hidden" name="challengeId" value="4" />

            <!-- Họ và tên (Thật) -->
            <div>
              <label for="realName" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                Họ và tên (Thật) <span class="text-[#CC785C]">*</span>
              </label>
              <input
                type="text"
                id="realName"
                name="realName"
                required
                value={existingProfile?.realName || ''}
                placeholder="Ví dụ: Lê Hoàng Phúc"
                class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
              />
              <p class="text-[11px] text-[#6B6860] mt-1 pl-1">Tên thật chỉ dùng cho xác thực nội bộ, <strong>không hiển thị công khai</strong>. Tên hiển thị trên Bảng xếp hạng sẽ tự lấy từ Discord.</p>
            </div>

            <!-- Grid 2 cột: Năm sinh & Nơi ở -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="birthYear" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Năm sinh <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="number"
                  id="birthYear"
                  name="birthYear" required
                  min="1950"
                  max="2030"
                  value={existingProfile?.birthYear || ''}
                  placeholder="Ví dụ: 2001"
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>

              <div>
                <label for="place" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Tỉnh / Thành phố / Quốc gia <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="text"
                  id="place"
                  name="place" required
                  value={existingProfile?.place || ''}
                  placeholder="Ví dụ: Hà Nội, TP.HCM, Tokyo..."
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>
            </div>

            <!-- Grid 2 cột: Chuyên ngành & Kiến thức học -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="major" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Nghề nghiệp / Chuyên ngành <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="text"
                  id="major"
                  name="major" required
                  value={existingProfile?.major || ''}
                  placeholder="Ví dụ: Y khoa, Kỹ sư phần mềm..."
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>

              <div>
                <label for="learning" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Kiến thức / Ngoại ngữ muốn học <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="text"
                  id="learning"
                  name="learning" required
                  value={existingProfile?.learning || ''}
                  placeholder="Ví dụ: Tiếng Anh IELTS, Tiếng Trung HSK..."
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>
            </div>

            <!-- Giới thiệu ngắn -->
            <div>
              <label for="bio" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                Giới thiệu ngắn <span class="text-[#CC785C]">*</span>
              </label>
              <textarea
                id="bio"
                name="bio" required
                rows="2"
                placeholder="Đôi dòng giới thiệu về bạn..."
                class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl p-3.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all resize-none"
              >{existingProfile?.bio || ''}</textarea>
            </div>

            <!-- Grid 2 cột: Facebook & Zalo (nội bộ) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="facebookUrl" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Facebook <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="text"
                  id="facebookUrl"
                  name="facebookUrl" required
                  value={existingProfile?.facebookUrl || ''}
                  placeholder="https://facebook.com/..."
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>

              <div>
                <label for="zaloUrl" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                  Zalo / SĐT <span class="text-[#CC785C]">*</span>
                </label>
                <input
                  type="text"
                  id="zaloUrl"
                  name="zaloUrl" required
                  value={existingProfile?.zaloUrl || ''}
                  placeholder="https://zalo.me/... hoặc SĐT"
                  class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
                />
              </div>
            </div>
            <p class="text-[11px] text-[#6B6860] -mt-2 pl-1">Thông tin liên hệ chỉ dùng nội bộ để liên hệ/trao giải, <strong>không hiển thị công khai</strong>.</p>

            <!-- Mục tiêu chuyên cần (%) -->
            <div>
              <label for="attendanceGoal" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                Mục tiêu chuyên cần (%) <span class="text-[#CC785C]">*</span>
              </label>
              <input
                type="number"
                id="attendanceGoal"
                name="attendanceGoal" required
                min="0"
                max="100"
                value={existingProfile?.attendanceGoal || ''}
                placeholder="Ví dụ: 100"
                class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
              />
              <p class="text-[11px] text-[#6B6860] mt-1 pl-1">Tỉ lệ điểm danh bạn đặt mục tiêu đạt được trong mùa này (0–100%).</p>
            </div>

            <!-- Mục tiêu thử thách -->
            <div>
              <label for="goals" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                Mục tiêu trong mùa 11 <span class="text-[#CC785C]">*</span>
              </label>
              <textarea
                id="goals"
                name="goals" required
                rows="3"
                placeholder="Ví dụ: Duy trì 100 ngày không bỏ lỡ ngày nào, ôn tập 100 thẻ mỗi ngày..."
                class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl p-3.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all resize-none"
              >{existingProfile?.goals || ''}</textarea>
            </div>

            <!-- Trích dẫn / Lời hứa kỷ luật -->
            <div>
              <label for="quotes" class="block text-xs font-medium uppercase tracking-wider text-[#6B6860] mb-1.5">
                Châm ngôn / Lời hứa kỷ luật
              </label>
              <input
                type="text"
                id="quotes"
                name="quotes"
                value={existingProfile?.quotes || ''}
                placeholder="Ví dụ: Không có áp lực, không có kim cương"
                class="w-full bg-[#FAF9F5] border border-[#E6DFD8] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] rounded-xl px-4 py-2.5 text-sm text-[#141413] placeholder-[#9C948A] outline-none transition-all"
              />
            </div>

            <!-- Cam kết hoàn thành -->
            <div class="p-4 rounded-xl bg-[#F6F4EE] border border-[#E6DFD8]">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  name="commitment"
                  id="commitmentCheck"
                  required
                  class="mt-0.5 w-4 h-4 rounded text-[#CC785C] focus:ring-[#CC785C] bg-[#FAF9F5] border-[#E6DFD8]"
                />
                <span class="text-xs sm:text-sm text-[#6B6860] leading-relaxed font-normal">
                  Tôi cam kết tham gia nghiêm túc mùa thử thách Anki Challenge 11, học bài đều đặn mỗi ngày và điểm danh qua bot Discord. <span class="text-[#CC785C]">*</span>
                </span>
              </label>
            </div>

            <!-- Notice if registration is locked -->
            {!isRegistrationOpen && (
              <div id="lockedFormNotice" class="p-4 rounded-xl bg-[#F6F4EE] border border-[#E6DFD8] flex items-start gap-3">
                <span class="text-[#CC785C] text-base shrink-0">⏳</span>
                <div class="text-xs text-[#6B6860] leading-relaxed">
                  <strong class="text-[#141413]">Cổng đăng ký chưa mở:</strong> Biểu mẫu Anki Challenge 11 sẽ mở vào ngày <strong class="text-[#141413]">22/08/2026 lúc 00:00 (GMT+7)</strong>. Bạn có thể kiểm tra trước các thông tin, nút đăng ký sẽ tự động mở khi đến giờ!
                </div>
              </div>
            )}

            <!-- Error message container -->
            <div id="formErrorMsg" class="hidden p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-medium"></div>

            <!-- Submit Button (Claude Terracotta Coral Pill Primary CTA) -->
            <div class="pt-2">
              <button
                type="submit"
                id="submitBtn"
                disabled={!isRegistrationOpen}
                class={`w-full py-3.5 px-6 rounded-full font-medium text-sm transition-all flex items-center justify-center gap-2 ${
                  isRegistrationOpen
                    ? "bg-[#CC785C] hover:bg-[#B8684E] text-white active:scale-[0.99] cursor-pointer shadow-sm"
                    : "bg-[#F3EFEA] text-[#9C948A] border border-[#E6DFD8] cursor-not-allowed"
                }`}
              >
                <span id="submitBtnText">{isRegistrationOpen ? "Gửi Đăng Ký Anki Challenge 11" : "Chưa mở hạn đăng ký (Mở ngày 22/08/2026)"}</span>
                <svg id="submitLoadingSpinner" class="hidden animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

          </form>
        </div>

      </div>

      <!-- SUCCESS MODAL / CARD (Claude Clean Success Card) -->
      <div id="successCard" class="hidden bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-8 sm:p-12 text-center shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
        <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-[#F3EFEA] border border-[#E6DFD8] flex items-center justify-center text-[#437A55]">
          <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h2 class="text-2xl font-normal font-['Newsreader','EB_Garamond',serif] text-[#141413] mb-2">
          Đăng ký AC11 thành công!
        </h2>
        <p class="text-[#6B6860] text-sm max-w-md mx-auto mb-6 leading-relaxed">
          Bạn đã đăng ký tham gia Anki Challenge 11 thành công. Thông tin của bạn đã được ghi nhận an toàn vào hệ thống.
        </p>
        <div id="autoApprovedNotice" class="hidden mb-6 p-4 rounded-xl bg-[#E7F1EA] border border-[#CBE0D2] text-[#3F6B53] text-sm font-medium text-left leading-relaxed"></div>

        <!-- Khối đóng phí (hiện khi không đủ điều kiện tự duyệt) -->
        <div id="paymentNotice" class="hidden mb-6 p-5 rounded-2xl bg-[#F6EFDD] border border-[#E9DDBB] text-left">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#9A7828] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <h3 id="paymentTitle" class="text-base font-bold text-[#9A7828]">Cần đóng phí tham gia</h3>
          </div>
          <p id="paymentDesc" class="text-sm text-[#7A6752] mb-4 leading-relaxed">Bạn chưa đủ điều kiện tự duyệt (kỷ luật ≤ 90% thử thách trước hoặc thành viên mới). Vui lòng đóng phí <strong class="text-[#9A7828]">20.000 VNĐ</strong> qua chuyển khoản để hoàn tất đăng ký:</p>
          <div class="flex flex-col sm:flex-row items-center gap-5">
            <img src="/images/ankichallenge11-qr.png" alt="QR Timo AC11" class="w-48 h-48 rounded-xl border border-[#E9DDBB] bg-white object-contain shrink-0" onerror="this.style.display='none'" />
            <div class="text-sm text-[#7A6752] space-y-2 flex-1 min-w-0">
              <p class="flex items-center gap-2 flex-wrap"><strong>Mã pot:</strong> <span class="font-mono font-semibold text-[#141413]">B871</span>
                <button type="button" class="copy-btn" onclick="const b=event.currentTarget;navigator.clipboard.writeText('B871').then(()=>{const o=b.innerText;b.innerText='Đã chép ✓';setTimeout(()=>b.innerText=o,2000)})">Copy</button>
              </p>
              <p><strong>Chủ tài khoản:</strong> LE HOANG PHUC</p>
              <p><strong>Nền tảng:</strong> Timo Digital Bank by BVBank</p>
              <p class="flex items-center gap-2 flex-wrap"><strong>Nội dung:</strong> <span class="font-mono font-semibold text-[#141413]">anki 11 + tên</span>
                <button type="button" class="copy-btn" onclick="const b=event.currentTarget;navigator.clipboard.writeText('anki 11').then(()=>{const o=b.innerText;b.innerText='Đã chép ✓';setTimeout(()=>b.innerText=o,2000)})">Copy</button>
              </p>
            </div>
          </div>
          <p class="text-xs text-[#9A7828] mt-3">Sau khi chuyển khoản, vui lòng nhắn tin Facebook để Ban tổ chức xác nhận và duyệt đăng ký của bạn:</p>
          <a href="https://www.facebook.com/tui.la.phuc747/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-2 px-4 py-2 bg-[#1877F2] hover:bg-[#166FE5] text-white text-xs font-semibold rounded-lg transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Nhắn tin Facebook cho Phúc
          </a>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#CC785C] hover:bg-[#B8684E] text-white font-medium px-6 py-2.5 rounded-full text-xs transition-all shadow-sm"
          >
            <span>Xem Bảng xếp hạng</span>
          </a>
          <a
            href={DISCORD_INVITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#F3EFEA] hover:bg-[#EDE7DF] text-[#141413] font-medium px-6 py-2.5 rounded-full border border-[#E6DFD8] text-xs transition-all"
          >
            <span>Vào Discord Anki VN</span>
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  // Client-side interactions
  const recheckBtn = document.getElementById("recheckGuildBtn");
  const form = document.getElementById("registrationForm") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement | null;
  const submitBtnText = document.getElementById("submitBtnText");
  const submitLoadingSpinner = document.getElementById("submitLoadingSpinner");
  const formErrorMsg = document.getElementById("formErrorMsg");
  const successCard = document.getElementById("successCard");
  const registrationFormContainer = document.getElementById("registrationFormContainer");
  const notInGuildCard = document.getElementById("notInGuildCard");
  const successProfileLink = document.getElementById("successProfileLink") as HTMLAnchorElement | null;

  if (recheckBtn) {
    recheckBtn.addEventListener("click", async () => {
      const originalText = recheckBtn.innerHTML;
      recheckBtn.disabled = true;
      recheckBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Đang kiểm tra...</span>
      `;

      try {
        const res = await fetch("/api/auth/check-guild");
        const data = await res.json();

        if (data.authenticated && data.inGuild) {
          window.location.reload();
        } else {
          alert("Hệ thống vẫn chưa tìm thấy bạn trong máy chủ Discord Anki Việt Nam. Hãy chắc chắn bạn đã nhấn vào link tham gia máy chủ nhé!");
          recheckBtn.disabled = false;
          recheckBtn.innerHTML = originalText;
        }
      } catch (err) {
        alert("Có lỗi khi kiểm tra. Vui lòng thử lại!");
        recheckBtn.disabled = false;
        recheckBtn.innerHTML = originalText;
      }
    });
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (formErrorMsg) {
        formErrorMsg.classList.add("hidden");
        formErrorMsg.textContent = "";
      }

      if (submitBtn && submitBtnText && submitLoadingSpinner) {
        submitBtn.disabled = true;
        submitBtnText.textContent = "Đang xử lý...";
        submitLoadingSpinner.classList.remove("hidden");
      }

      const formData = new FormData(form);

      try {
        const res = await fetch("/api/register", {
          method: "POST",
          body: formData,
        });

        const result = await res.json();

        if (!res.ok || !result.success) {
          throw new Error(result.error || "Đăng ký thất bại. Vui lòng thử lại!");
        }

        if (registrationFormContainer) registrationFormContainer.classList.add("hidden");
        if (notInGuildCard) notInGuildCard.classList.add("hidden");
        if (successCard) successCard.classList.remove("hidden");

        // Nếu được auto-approve (kỷ luật > 90%) → hiện thông báo ngay
        if (result.autoApproved && result.autoApprovedMessage) {
          const notice = document.getElementById("autoApprovedNotice");
          if (notice) {
            notice.textContent = "✅ " + result.autoApprovedMessage;
            notice.classList.remove("hidden");
          }
        }

        // Hiện khối chuyển khoản cho CẢ 2 trường hợp:
        // - chưa auto duyệt: phí BẮT BUỘC
        // - đã auto duyệt: đóng góp TỰ NGUYỆN (có lòng thì giúp)
        const payment = document.getElementById("paymentNotice");
        const paymentTitle = document.getElementById("paymentTitle");
        const paymentDesc = document.getElementById("paymentDesc");
        if (payment) {
          if (result.autoApproved) {
            if (paymentTitle) paymentTitle.textContent = "Đóng góp tự nguyện \uD83D\uDC9B";
            if (paymentDesc) paymentDesc.innerHTML = 'Phí tham gia chỉ áp dụng <strong>bắt buộc</strong> cho người chưa đủ điều kiện tự duyệt. Nhưng nếu bạn có lòng, có thể đóng góp <strong class="text-[#9A7828]">20.000 VNĐ</strong> để giúp mình xây dựng những thứ tốt hơn trong tương lai :))';
          }
          payment.classList.remove("hidden");
        }

        if (successProfileLink && result.user?.id) {
          successProfileLink.href = `/profile/${result.user.id}`;
        }
      } catch (err: any) {
        if (formErrorMsg) {
          formErrorMsg.textContent = err.message || "Đã xảy ra lỗi khi gửi form.";
          formErrorMsg.classList.remove("hidden");
        }
      } finally {
        if (submitBtn && submitBtnText && submitLoadingSpinner) {
          submitBtn.disabled = false;
          submitBtnText.textContent = "Gửi Đăng Ký Anki Challenge 11";
          submitLoadingSpinner.classList.add("hidden");
        }
      }
    });
  }
</script>

<style>
  .copy-btn {
    margin-left: 0.35rem;
    padding: 0.12rem 0.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    background: #FFFFFF;
    border: 1px solid #E9DDBB;
    color: #9A7828;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .copy-btn:hover {
    background: #F6EFDD;
  }
</style>
