) : (
  <Layout title="Đăng nhập Admin - Anki Challenge">
    <main class="min-h-screen bg-[#FAF9F5] text-[#141413] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8 font-['Plus_Jakarta_Sans','Inter',sans-serif] selection:bg-[#CC785C]/20 selection:text-[#141413]">
