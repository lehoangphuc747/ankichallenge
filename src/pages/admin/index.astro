              </button>
            </div>
          </form>
          
          <div class="text-center mt-6">
            <a href="/" class="inline-flex items-center gap-1.5 text-sm font-bold text-[#6B6860] hover:text-[#B8684E] transition-all uppercase tracking-wider">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
              <span>Quay lại Trang chủ</span>
            </a>
          </div>
        </div>
      </div>
    </main>
  </Layout>
)}

<script>
  // Load and display stats
  async function loadStats() {
    const totalMembersEl = document.getElementById("totalMembers");
    if (!totalMembersEl) return;

    try {
      const metadataResponse = await fetch("/api/data/metadata?v=" + Date.now());
      const metadata = await metadataResponse.json();
      const cacheBuster = metadata?.lastUpdated
        ? "?v=" + new Date(metadata.lastUpdated).getTime()
        : "?v=" + Date.now();

      const [usersResponse, challengesResponse] = await Promise.all([
        fetch("/api/data/users" + cacheBuster),
        fetch("/api/data/challenges" + cacheBuster),
      ]);

      const usersData = await usersResponse.json();
      const challengesData = await challengesResponse.json();

      const today = new Date().toISOString().split("T")[0];
      
      let activeChallengeId = '2';
      for (const [id, data] of Object.entries(challengesData as Record<string, any>)) {
          if (today >= data.start && today <= data.end) {
              activeChallengeId = id;
              break;
          }
      }

      let prefix = '08';
      if (activeChallengeId === '1') prefix = '08';
      if (activeChallengeId === '2') prefix = '09';
      if (activeChallengeId === '3') prefix = '10';
      if (activeChallengeId === '4') prefix = '11';

      const studyRecordsResponse = await fetch(`/api/data/records_${prefix}` + cacheBuster);
      const studyRecordsData = await studyRecordsResponse.json();

      const totalMembers = usersData.data?.length || 0;
      const activeMembers = usersData.data?.filter((u) => !u.hidden).length || 0;

      const todayRecords = studyRecordsData[today] || {};
      const todayCheckins = Object.keys(todayRecords).length;

      totalMembersEl.textContent = totalMembers.toString();
      const activeMembersEl = document.getElementById("activeMembers");
      if (activeMembersEl) activeMembersEl.textContent = activeMembers.toString();
      const todayCheckinsEl = document.getElementById("todayCheckins");
      if (todayCheckinsEl) todayCheckinsEl.textContent = todayCheckins.toString();
      const daysLeftEl = document.getElementById("daysLeft");
      if (daysLeftEl) daysLeftEl.textContent = "—";

      const lastUpdateEl = document.getElementById("lastUpdate");
      if (lastUpdateEl && metadata.lastUpdated) {
        lastUpdateEl.textContent = new Date(metadata.lastUpdated).toLocaleString("vi-VN");
      }
    } catch (error) {
      console.error("Error loading stats:", error);
    }
  }

  let cachedMemberList: any[] = [];
  let currentMapLogItem: any = null;

  async function loadMemberListForMap() {
    if (cachedMemberList.length > 0) return cachedMemberList;
    try {
      const res = await fetch("/api/data/users?v=" + Date.now());
      const usersData = await res.json();
      cachedMemberList = Array.isArray(usersData?.data) ? usersData.data : [];
      cachedMemberList.sort((a, b) => a.name.localeCompare(b.name, 'vi'));
    } catch {
      cachedMemberList = [];
    }
    return cachedMemberList;
  }

  async function loadLoginHistory() {
    const tbody = document.getElementById("discordLoginHistoryBody");
    if (!tbody) return;

    try {
      const res = await fetch("/api/data/login_history?v=" + Date.now());
      if (!res.ok) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-[#8E8B82] font-medium">Chưa có lượt đăng nhập Discord nào được ghi nhận</td></tr>`;
        return;
      }
      const historyList = await res.json();
      if (!Array.isArray(historyList) || historyList.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-[#8E8B82] font-medium">Chưa có lượt đăng nhập Discord nào được ghi nhận</td></tr>`;
        return;
      }

      tbody.innerHTML = historyList.map((item: any) => {
        const timeAgo = new Date(item.loggedAt).toLocaleString("vi-VN", { timeZone: "Asia/Ho_Chi_Minh" });
        const mappedBadge = item.memberId 
          ? `<div class="flex items-center gap-2">
              <span class="px-2.5 py-1 bg-[#E7F1EA] text-[#3F6B53] font-bold text-xs rounded-lg border border-[#CBE0D2] inline-flex items-center gap-1">
                <span>✅</span> ID #${item.memberId} - ${item.memberName || 'Thành viên'}
              </span>
              <button class="map-log-btn text-xs font-bold text-[#B8684E] hover:text-[#944E34] underline cursor-pointer" 
                data-item='${JSON.stringify(item).replace(/'/g, "&apos;")}'>Sửa</button>
             </div>`
          : `<div class="flex items-center gap-2">
              <span class="px-2.5 py-1 bg-[#F6EFDD] text-[#9A7828] font-bold text-xs rounded-lg border border-[#E9DDBB] inline-flex items-center gap-1">
                <span>⚠️</span> Chưa ghép nối
              </span>
              <button class="map-log-btn px-2.5 py-1 bg-[#CC785C] hover:bg-[#B8684E] active:scale-95 text-white font-bold text-xs rounded-lg shadow-sm transition-all cursor-pointer" 
                data-item='${JSON.stringify(item).replace(/'/g, "&apos;")}'>🔗 Ghép nối</button>
             </div>`;

        return `
          <tr class="hover:bg-[#FBF7F1]/70 transition-colors">
            <td class="py-3.5 px-2">
              <div class="flex items-center gap-3">
                <img src="${item.avatar}" class="w-9 h-9 rounded-full bg-[#F3EFEA] object-cover flex-shrink-0" alt="" />
                <div>
                  <div class="font-bold text-[#141413] leading-snug">${item.displayName}</div>
                  <div class="text-xs text-[#8E8B82] font-mono">@${item.username} (ID: ${item.discordId})</div>
                </div>
              </div>
            </td>
            <td class="py-3.5 px-2 text-[#6B6860] text-xs font-mono">${item.email || '<span class="text-[#C9C2B7]">Không có email</span>'}</td>
            <td class="py-3.5 px-2">${mappedBadge}</td>
            <td class="py-3.5 px-2 text-right font-semibold text-xs text-[#6B6860]">${timeAgo}</td>
          </tr>
        `;
      }).join("");

      document.querySelectorAll(".map-log-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const itemData = JSON.parse(btn.getAttribute("data-item") || "{}");
          openMapModal(itemData);
        });
      });
    } catch (e) {
      console.error("Error loading login history:", e);
      tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-red-500 font-medium">Không thể tải dữ liệu nhật ký</td></tr>`;
    }
  }

  async function openMapModal(item: any) {
    currentMapLogItem = item;
    const modal = document.getElementById("mapMemberModal");
    const avatarEl = document.getElementById("mapModalAvatar") as HTMLImageElement;
    const nameEl = document.getElementById("mapModalName");
    const subEl = document.getElementById("mapModalSub");
    const selectEl = document.getElementById("mapMemberSelect") as HTMLSelectElement;

    if (!modal || !selectEl) return;

    if (avatarEl) avatarEl.src = item.avatar;
    if (nameEl) nameEl.textContent = item.displayName;
    if (subEl) subEl.textContent = `@${item.username} (ID: ${item.discordId})`;

    const members = await loadMemberListForMap();
    selectEl.innerHTML = `<option value="">-- Chọn thành viên --</option>` +
      members.map((m: any) => `
        <option value="${m.id}" ${item.memberId === m.id ? 'selected' : ''}>
          ID #${m.id} - ${m.name} ${m.discordNickname ? `(Nick: ${m.discordNickname})` : ''}
        </option>
      `).join("");

    modal.classList.remove("hidden");
  }

  function closeMapModal() {
    document.getElementById("mapMemberModal")?.classList.add("hidden");
    currentMapLogItem = null;
  }

  document.getElementById("closeMapModalBtn")?.addEventListener("click", closeMapModal);
  document.getElementById("cancelMapModalBtn")?.addEventListener("click", closeMapModal);

  document.getElementById("confirmMapBtn")?.addEventListener("click", async () => {
    if (!currentMapLogItem) return;
    const selectEl = document.getElementById("mapMemberSelect") as HTMLSelectElement;
    const memberId = selectEl.value;

    if (!memberId) {
      alert("Vui lòng chọn 1 thành viên để ghép nối!");
      return;
    }

    const confirmBtn = document.getElementById("confirmMapBtn") as HTMLButtonElement;
    confirmBtn.disabled = true;
    confirmBtn.textContent = "⏳ Đang lưu...";

    try {
      const res = await fetch("/api/admin/map-discord", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          logId: currentMapLogItem.id,
          discordId: currentMapLogItem.discordId,
          discordNickname: currentMapLogItem.username,
          email: currentMapLogItem.email,
          memberId: parseInt(memberId),
        }),
      });

      const data = await res.json();
      if (data.success) {
        alert(data.message || "Đã ghép nối thành công!");
        closeMapModal();
        cachedMemberList = [];
        loadLoginHistory();
        loadStats();
      } else {
        alert("Lỗi: " + (data.error || "Không thể ghép nối"));
      }
    } catch (err: any) {
      alert("Lỗi hệ thống: " + err.message);
    } finally {
      confirmBtn.disabled = false;
      confirmBtn.textContent = "Lưu Ghép Nối";
    }
  });

  document.getElementById("refreshLoginHistoryBtn")?.addEventListener("click", () => {
    cachedMemberList = [];
    loadLoginHistory();
  });

  loadStats();
  loadLoginHistory();
</script>