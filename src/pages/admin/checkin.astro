---
import Layout from "../../layouts/Layout.astro";
import DatePickerWithSearch from "../../components/admin/DatePickerWithSearch";
---

<Layout title="Admin Check-in - Anki Challenge">
  <main class="min-h-screen bg-[#FAF9F5] text-[#141413] py-8 px-4 sm:px-6 font-['Plus_Jakarta_Sans','Inter',sans-serif] selection:bg-[#CC785C]/20 selection:text-[#141413]">
    <div class="max-w-7xl mx-auto space-y-4">

      <!-- Top Bar -->
      <div class="flex flex-col md:flex-row md:items-center justify-between bg-[#FFFFFF] p-4 sm:p-5 rounded-2xl shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-[#E6DFD8] gap-4">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[#F0EAE1] text-[#CC785C] border border-[#E6DFD8] shadow-xs">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="m9 14 2 2 4-4"/></svg>
          </span>
          <div>
            <h1 class="text-2xl font-serif font-medium tracking-tight text-[#141413]">Quản lý Check-in</h1>
            <p class="text-xs font-medium text-[#8E8B82] mt-0.5">Click vào hàng để cập nhật trạng thái</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <div class="relative">
            <select id="challengeSelect" class="appearance-none bg-[#F3EFEA] hover:bg-[#EAE4DC] border border-[#E6DFD8] text-[#141413] text-sm font-semibold py-2 pl-3 pr-8 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#CC785C]/30 transition-all cursor-pointer shadow-xs">
              <option value="">Đang tải...</option>
            </select>
            <svg class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none text-[#8E8B82] h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
          <a href="/" class="inline-flex items-center gap-1.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] border border-[#E6DFD8] text-sm font-semibold px-3 py-2 rounded-xl transition-all shadow-xs">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 0 0 5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 1 0 5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            <span>Leaderboard</span>
          </a>
          <a href="/admin" class="inline-flex items-center gap-1.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] border border-[#E6DFD8] text-sm font-semibold px-3 py-2 rounded-xl transition-all shadow-xs">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Dashboard</span>
          </a>
        </div>
      </div>

      <!-- Toast Notification -->
      <div id="toast" class="fixed top-4 right-4 z-50 hidden">
        <div class="bg-white rounded-2xl shadow-2xl border-l-4 border-[#5F8D73] p-3 min-w-[250px] border border-[#E6DFD8] transform transition-all duration-300 flex items-center">
          <div class="text-xl mr-3" id="toastIcon">✅</div>
          <div>
            <p class="font-bold text-sm text-[#141413]" id="toastTitle">Thành công!</p>
            <p class="text-xs text-[#6B6860]" id="toastMessage">Đã lưu thay đổi</p>
          </div>
        </div>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-14">
        <div class="inline-flex items-center gap-3.5 px-7 py-4 bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl shadow-sm">
          <div class="relative w-6 h-6">
            <div class="absolute inset-0 rounded-full border-2 border-[#E6DFD8]"></div>
            <div class="absolute inset-0 rounded-full border-2 border-[#CC785C] border-t-transparent animate-spin"></div>
          </div>
          <p class="text-base font-semibold text-[#141413]">Đang tải dữ liệu...</p>
        </div>
      </div>

      <div id="content" class="hidden space-y-4">
        <!-- Main Controls Row -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

          <!-- Left: Calendar & Search -->
          <div class="lg:col-span-7 xl:col-span-8 flex flex-col gap-4">
            <div class="bg-[#FFFFFF] p-3 rounded-2xl border border-[#E6DFD8] shadow-[0_4px_20px_rgba(0,0,0,0.03)] flex flex-col sm:flex-row items-center gap-3">
              <div class="flex-shrink-0">
                 <DatePickerWithSearch client:visible />
                 <input type="hidden" id="selectedDate" />
              </div>

              <div class="flex-1 w-full relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-[#8E8B82]">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                </div>
                <input type="text" id="searchInput" placeholder="Tìm tên/Discord..." class="w-full pl-9 pr-9 py-2.5 bg-[#FFFFFF] border border-[#E6DFD8] rounded-xl text-sm font-medium text-[#141413] placeholder-[#8E8B82] focus:border-[#CC785C] focus:ring-2 focus:ring-[#CC785C]/20 outline-none transition-all" />
                <button id="clearSearch" class="absolute inset-y-0 right-0 pr-3 flex items-center text-[#8E8B82] hover:text-[#141413] focus:outline-none" title="Xóa tìm kiếm">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- Right: Compact Stats -->
          <div class="lg:col-span-5 xl:col-span-4 bg-[#FFFFFF] p-3 rounded-2xl border border-[#E6DFD8] shadow-[0_4px_20px_rgba(0,0,0,0.03)] flex flex-col justify-center">
              <div class="grid grid-cols-2 gap-3">
                <div class="bg-[#E7F1EA] p-2.5 rounded-xl border border-[#CBE0D2] flex items-center justify-between shadow-sm">
                  <span class="text-xs font-bold text-[#3F6B53]">Đã Check</span>
                  <span class="text-xl font-black text-[#4C7a60]" id="checkedCount">0</span>
                </div>
                <div class="bg-[#F6EFDD] p-2.5 rounded-xl border border-[#E9DDBB] flex items-center justify-between shadow-sm">
                  <span class="text-xs font-bold text-[#9A7828]">Chưa Check</span>
                  <span class="text-xl font-black text-[#A8852F]" id="uncheckedCount">0</span>
                </div>
                <div class="bg-[#F9E3D7] p-2.5 rounded-xl border border-[#F0C8B2] flex items-center justify-between shadow-sm">
                  <span class="text-xs font-bold text-[#B8684E]">Tỷ lệ</span>
                  <span class="text-xl font-black text-[#CC785C]" id="checkinRate">0%</span>
                </div>
                <div class="bg-[#EFE9E3] p-2.5 rounded-xl border border-[#DFD6CC] flex items-center justify-between shadow-sm">
                  <span class="text-xs font-bold text-[#7A6752]">Ngày</span>
                  <span class="text-xl font-black text-[#6B6860]" id="dayCounter">-</span>
                </div>
              </div>
          </div>
        </div>

        <!-- Check-in Lists - 2 Columns -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <!-- Left: Unchecked -->
          <div class="bg-[#FFFFFF] rounded-2xl border border-[#E6DFD8] overflow-hidden flex flex-col h-[min(800px,calc(100vh-220px))] relative shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
            <div class="bg-[#F6EFDD] border-b border-[#E9DDBB] px-4 py-2.5 flex items-center justify-between shrink-0 sticky top-0 z-10 shadow-sm">
              <h2 class="text-sm font-bold text-[#9A7828] flex items-center gap-2">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Chưa check-in (<span id="uncheckedHeader">0</span>)
              </h2>
              <button id="copyDiscordNamesBtn" class="px-2.5 py-1 bg-[#FFFFFF] text-[#9A7828] border border-[#E9DDBB] hover:bg-[#F6EFDD] hover:text-[#A8852F] rounded-lg text-xs font-bold transition-colors flex items-center gap-1 shadow-sm">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                Copy Discord
              </button>
            </div>
            <div id="uncheckedList" class="divide-y divide-[#F0EAE1] flex-1 overflow-y-auto bg-[#FBF7F1]/40">
              <!-- Will be populated by JavaScript -->
            </div>
          </div>

          <!-- Right: Checked -->
          <div class="bg-[#FFFFFF] rounded-2xl border border-[#E6DFD8] overflow-hidden flex flex-col h-[min(800px,calc(100vh-220px))] relative shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
            <div class="bg-[#E7F1EA] border-b border-[#CBE0D2] px-4 py-2.5 shrink-0 flex items-center sticky top-0 z-10 shadow-sm">
              <h2 class="text-sm font-bold text-[#3F6B53] flex items-center gap-2">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                Đã check-in (<span id="checkedHeader">0</span>)
              </h2>
            </div>
            <div id="checkedList" class="divide-y divide-[#F0EAE1] flex-1 overflow-y-auto bg-[#FBF7F1]/40">
              <!-- Will be populated by JavaScript -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Import và khởi chạy checkin admin module
  import { initCheckin } from "../../scripts/admin/checkin";
  initCheckin();
</script>

<style>
  @keyframes slideIn {
    from {
      transform: translateX(100%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  #toast:not(.hidden) {
    animation: slideIn 0.3s ease-out;
  }

  .checkin-item:focus {
    outline: none;
  }

  .checkin-item {
    transition: all 0.2s ease-in-out;
  }
</style>