---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin - Danh sách thành viên">
  <main class="min-h-screen bg-[#FAF9F5] text-[#141413] py-10 px-4 sm:px-6 font-['Plus_Jakarta_Sans','Inter',sans-serif] selection:bg-[#CC785C]/20 selection:text-[#141413]">
    <div class="max-w-7xl mx-auto space-y-6">
      <!-- Header -->
      <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-[#F0EAE1] text-[#CC785C] border border-[#E6DFD8] shadow-xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
          <div>
            <h1 class="text-3xl font-serif font-medium tracking-tight text-[#141413]">Danh sách thành viên</h1>
            <p class="text-[#8E8B82] text-sm font-medium mt-0.5">Admin · Quản lý hồ sơ & thông tin người chơi</p>
          </div>
        </div>
        <button id="toggleHiddenBtn" class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] border border-[#E6DFD8] text-sm font-semibold rounded-xl transition-all shadow-xs cursor-pointer">
          <svg id="eyeIcon" class="h-4 w-4 text-[#8E8B82]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          <span id="toggleHiddenLabel">Hiện thành viên ẩn</span>
        </button>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-16">
        <div class="inline-flex items-center gap-3.5 px-7 py-4 bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl shadow-sm">
          <div class="relative w-6 h-6">
            <div class="absolute inset-0 rounded-full border-2 border-[#E6DFD8]"></div>
            <div class="absolute inset-0 rounded-full border-2 border-[#CC785C] border-t-transparent animate-spin"></div>
          </div>
          <p class="text-base font-semibold text-[#141413]">Đang tải dữ liệu...</p>
        </div>
      </div>

      <!-- Table -->
      <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
        <div class="overflow-x-auto">
          <table id="membersTable" class="w-full text-sm text-left text-[#3D3D3A]">
            <thead class="text-xs uppercase bg-[#F6F4EE] text-[#6B6860] font-bold">
              <tr>
                <th class="px-6 py-4">#</th>
                <th class="px-6 py-4">Tên</th>
                <th class="px-6 py-4">Discord</th>
                <th class="px-6 py-4">Ngôn ngữ</th>
                <th class="px-6 py-4">Chuyên ngành</th>
                <th class="px-6 py-4">Liên hệ</th>
                <th class="px-6 py-4">Thao tác</th>
              </tr>
            </thead>
            <tbody id="membersBody" class="divide-y divide-[#F0EAE1]"></tbody>
          </table>
        </div>
      </div>

      <!-- Edit Modal -->
      <div id="editModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-50 p-4">
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-3xl p-7 max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto shadow-2xl">
          <div class="flex items-center justify-between border-b border-[#E6DFD8] pb-4 mb-6">
            <h2 class="text-xl font-serif font-medium text-[#141413]">Chỉnh sửa thành viên</h2>
            <button type="button" id="closeEditX" class="text-[#8E8B82] hover:text-[#141413] text-xl font-bold p-1 cursor-pointer">&times;</button>
          </div>
          <form id="editForm" class="space-y-5">
            <input type="hidden" id="editId" />

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Tên *</label>
              <input type="text" id="editName" required class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Email</label>
              <input type="email" id="editEmail" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Ngôn ngữ học</label>
                <input type="text" id="editLanguage" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Chuyên ngành</label>
                <input type="text" id="editMajor" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Năm sinh</label>
                <input type="number" id="editBirthYear" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Vai trò</label>
                <select id="editRole" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all cursor-pointer">
                  <option value="member">Thành viên</option>
                  <option value="admin">Admin</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Bio</label>
              <textarea id="editBio" rows="3" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all resize-none"></textarea>
            </div>

            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Discord Nickname</label>
              <input type="text" id="editDiscordNickname" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" placeholder="username" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Facebook URL</label>
                <input type="url" id="editFacebook" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
              </div>
              <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-[#6B6860] mb-1.5">Zalo URL</label>
                <input type="url" id="editZalo" class="w-full px-4 py-2.5 bg-[#FAF9F5] border border-[#E6DFD8] rounded-xl text-sm text-[#141413] focus:border-[#CC785C] focus:ring-1 focus:ring-[#CC785C] outline-none transition-all" />
              </div>
            </div>

            <div class="flex items-center gap-2">
              <input type="checkbox" id="editHidden" class="w-4 h-4 rounded text-[#CC785C] focus:ring-[#CC785C] bg-[#FAF9F5] border-[#E6DFD8]" />
              <label for="editHidden" class="text-sm font-medium text-[#6B6860]">Ẩn thành viên</label>
            </div>

            <div class="flex gap-3 justify-end pt-3">
              <button type="button" id="cancelEdit" class="px-4 py-2.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] text-sm font-semibold rounded-xl border border-[#E6DFD8] transition-all cursor-pointer">
                Hủy
              </button>
              <button type="submit" class="px-4 py-2.5 bg-[#CC785C] hover:bg-[#B8684E] active:scale-[0.98] text-white text-sm font-semibold rounded-xl transition-all cursor-pointer shadow-sm">
                Lưu thay đổi
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  interface Member {
    id: number;
    name: string;
    bio: string;
    email: string;
    role: string;
    hidden: boolean;
    learning: string;
    major: string;
    birthYear: number;
    facebookUrl: string;
    zaloUrl: string;
    discordNickname: string;
  }

  async function loadMembers() {
    try {
      const loadingDiv = document.getElementById('loading');
      const membersBody = document.getElementById('membersBody');
      
      const usersResponse = await fetch('/api/data/users?v=' + Date.now());
      const usersData = await usersResponse.json();
      
      if (!usersData || !usersData.data) {
        if (loadingDiv) loadingDiv.innerHTML = '<p class="text-[#C0553C]">Không tìm thấy dữ liệu</p>';
        return;
      }
      
      const members: Member[] = usersData.data || [];
      const showHidden = window.showHiddenMembers || false;
      const visibleMembers = showHidden ? members : members.filter(m => !m.hidden);
      visibleMembers.sort((a, b) => a.name.localeCompare(b.name));
      
      if (loadingDiv) loadingDiv.style.display = 'none';
      if (!membersBody) return;
      
      membersBody.innerHTML = visibleMembers.map((member, index) => `
        <tr class="border-b border-[#F0EAE1] hover:bg-[#FBF7F1]/70 transition-colors ${member.hidden ? 'bg-[#FBE3DC]/40' : ''}">
          <td class="px-6 py-4 text-[#8E8B82] font-bold">${index + 1}</td>
          <td class="px-6 py-4">
            <div class="font-semibold text-[#141413]">${member.name}</div>
            ${member.role === 'admin' ? '<span class="text-[11px] bg-[#F6EFDD] text-[#9A7828] px-2 py-0.5 rounded-full border border-[#E9DDBB]">Admin</span>' : ''}
            ${member.hidden ? '<span class="text-[11px] bg-[#FBE3DC] text-[#C0553C] px-2 py-0.5 rounded-full border border-[#F0C8B2] ml-2">Ẩn</span>' : ''}
          </td>
          <td class="px-6 py-4 text-sm text-[#6B6860]">${member.discordNickname || '-'}</td>
          <td class="px-6 py-4 text-sm">${member.learning}</td>
          <td class="px-6 py-4 text-sm">${member.major}</td>
          <td class="px-6 py-4">
            <div class="flex gap-2">
              ${member.facebookUrl ? '<a href="${member.facebookUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#B8684E] hover:underline text-xs font-semibold"><svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>FB</a>' : ''}
              ${member.zaloUrl ? '<a href="${member.zaloUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#4C7a60] hover:underline text-xs font-semibold"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>Zalo</a>' : ''}
            </div>
          </td>
          <td class="px-6 py-4">
            <button class="edit-btn inline-flex items-center gap-1 px-3 py-1.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] border border-[#E6DFD8] rounded-lg transition-all text-xs font-semibold shadow-xs cursor-pointer" data-id="${member.id}">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
              Sửa
            </button>
          </td>
        </tr>
      `).join('');
      
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const memberId = parseInt(btn.getAttribute('data-id') || '0');
          const member = visibleMembers.find(m => m.id === memberId);
          if (member) openEditModal(member, members);
        });
      });
      
    } catch (error) {
      console.error('Error loading members:', error);
      const loadingDiv = document.getElementById('loading');
      if (loadingDiv) loadingDiv.innerHTML = '<p class="text-[#C0553C]">Lỗi: ' + error.message + '</p>';
    }
  }

  function openEditModal(member: Member, allMembers: Member[]) {
    const modal = document.getElementById('editModal');
    if (!modal) return;

    (document.getElementById('editId') as HTMLInputElement).value = member.id.toString();
    (document.getElementById('editName') as HTMLInputElement).value = member.name || '';
    (document.getElementById('editEmail') as HTMLInputElement).value = member.email || '';
    (document.getElementById('editLanguage') as HTMLInputElement).value = member.learning || '';
    (document.getElementById('editMajor') as HTMLInputElement).value = member.major || '';
    (document.getElementById('editBirthYear') as HTMLInputElement).value = member.birthYear?.toString() || '';
    (document.getElementById('editRole') as HTMLSelectElement).value = member.role || 'member';
    (document.getElementById('editBio') as HTMLTextAreaElement).value = member.bio || '';
    (document.getElementById('editDiscordNickname') as HTMLInputElement).value = member.discordNickname || '';
    (document.getElementById('editFacebook') as HTMLInputElement).value = member.facebookUrl || '';
    (document.getElementById('editZalo') as HTMLInputElement).value = member.zaloUrl || '';
    (document.getElementById('editHidden') as HTMLInputElement).checked = member.hidden || false;

    modal.classList.remove('hidden');
    (modal as any)._allMembers = allMembers;
  }

  async function saveEdit() {
    const modal = document.getElementById('editModal');
    const memberId = parseInt((document.getElementById('editId') as HTMLInputElement).value);
    const allMembers: Member[] = (modal as any)._allMembers;

    const memberIndex = allMembers.findIndex(m => m.id === memberId);
    if (memberIndex === -1) {
      alert('Không tìm thấy thành viên');
      return;
    }

    allMembers[memberIndex] = {
      ...allMembers[memberIndex],
      name: (document.getElementById('editName') as HTMLInputElement).value,
      email: (document.getElementById('editEmail') as HTMLInputElement).value,
      learning: (document.getElementById('editLanguage') as HTMLInputElement).value,
      major: (document.getElementById('editMajor') as HTMLInputElement).value,
      birthYear: parseInt((document.getElementById('editBirthYear') as HTMLInputElement).value) || 0,
      role: (document.getElementById('editRole') as HTMLSelectElement).value,
      bio: (document.getElementById('editBio') as HTMLTextAreaElement).value,
      discordNickname: (document.getElementById('editDiscordNickname') as HTMLInputElement).value,
      facebookUrl: (document.getElementById('editFacebook') as HTMLInputElement).value,
      zaloUrl: (document.getElementById('editZalo') as HTMLInputElement).value,
      hidden: (document.getElementById('editHidden') as HTMLInputElement).checked
    };

    try {
      const response = await fetch('/api/update-users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ data: allMembers })
      });

      const result = await response.json();
      if (!result.success) throw new Error('Failed to save');

      alert('Đã lưu thay đổi!');
      modal?.classList.add('hidden');
      loadMembers();
    } catch (error) {
      console.error('Error saving:', error);
      alert('Lỗi khi lưu: ' + error.message);
    }
  }

  loadMembers();

  document.getElementById('cancelEdit')?.addEventListener('click', () => {
    document.getElementById('editModal')?.classList.add('hidden');
  });
  document.getElementById('closeEditX')?.addEventListener('click', () => {
    document.getElementById('editModal')?.classList.add('hidden');
  });

  document.getElementById('editForm')?.addEventListener('submit', (e) => {
    e.preventDefault();
    saveEdit();
  });

  document.getElementById('editModal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      e.currentTarget.classList.add('hidden');
    }
  });

  window.showHiddenMembers = false;
  document.getElementById('toggleHiddenBtn')?.addEventListener('click', (e) => {
    window.showHiddenMembers = !window.showHiddenMembers;
    const label = document.getElementById('toggleHiddenLabel');
    if (label) label.textContent = window.showHiddenMembers ? 'Ẩn thành viên đã ẩn' : 'Hiện thành viên ẩn';
    const btn = e.currentTarget as HTMLButtonElement;
    btn.className = window.showHiddenMembers
      ? 'inline-flex items-center gap-2 px-4 py-2.5 bg-[#FBE3DC] hover:bg-[#F7D2C5] text-[#C0553C] border border-[#F0C8B2] text-sm font-semibold rounded-xl transition-all shadow-xs cursor-pointer'
      : 'inline-flex items-center gap-2 px-4 py-2.5 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] border border-[#E6DFD8] text-sm font-semibold rounded-xl transition-all shadow-xs cursor-pointer';
    loadMembers();
  });
</script>