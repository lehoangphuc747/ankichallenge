---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin - Danh sách đăng ký">
  <main class="min-h-screen bg-[#FAF9F5] text-[#141413] py-12 px-4 sm:px-6 font-['Plus_Jakarta_Sans','Inter',sans-serif] selection:bg-[#CC785C]/20 selection:text-[#141413]">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <div class="flex items-center justify-between mb-10 pb-5 border-b border-[#E6DFD8] flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-[#F0EAE1] text-[#CC785C] border border-[#E6DFD8] shadow-xs">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/>
            </svg>
          </span>
          <div>
            <h1 class="text-3xl font-serif font-medium tracking-tight text-[#141413]">Danh sách đăng ký</h1>
            <p class="text-[#8E8B82] text-sm font-medium mt-0.5">Kiểm tra thành viên đã đăng ký các mùa Anki Challenge</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <!-- Challenge selector -->
          <div class="relative">
            <select id="challengeSelect" class="appearance-none bg-[#F3EFEA] hover:bg-[#EAE4DC] border border-[#E6DFD8] text-[#141413] text-sm font-semibold py-2.5 pl-4 pr-10 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#CC785C]/30 transition-all cursor-pointer shadow-xs">
              <option value="">Đang tải...</option>
            </select>
            <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none text-[#8E8B82] h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
          <a href="/admin" class="inline-flex items-center gap-2 bg-[#F3EFEA] hover:bg-[#EAE4DC] text-[#141413] font-semibold text-sm px-4 py-2.5 rounded-xl border border-[#E6DFD8] transition-all cursor-pointer">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span>Dashboard</span>
          </a>
        </div>
      </div>

      <!-- Stats -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex w-9 h-9 items-center justify-center rounded-xl bg-[#CC785C]/10 text-[#CC785C]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <div class="text-[#8E8B82] text-xs font-bold uppercase tracking-wider">Số đăng ký</div>
          </div>
          <div class="text-3xl font-serif font-semibold text-[#141413]" id="regCount">--</div>
        </div>
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex w-9 h-9 items-center justify-center rounded-xl bg-[#AE7A5A]/10 text-[#AE7A5A]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div class="text-[#8E8B82] text-xs font-bold uppercase tracking-wider">Có tên thật</div>
          </div>
          <div class="text-3xl font-serif font-semibold text-[#141413]" id="realNameCount">--</div>
        </div>
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex w-9 h-9 items-center justify-center rounded-xl bg-[#A8927B]/10 text-[#7A6752]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </span>
            <div class="text-[#8E8B82] text-xs font-bold uppercase tracking-wider">Có Zalo/SĐT</div>
          </div>
          <div class="text-3xl font-serif font-semibold text-[#141413]" id="zaloCount">--</div>
        </div>
        <div class="bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl p-5 shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
          <div class="flex items-center gap-3 mb-3">
            <span class="flex w-9 h-9 items-center justify-center rounded-xl bg-[#CC9E5A]/10 text-[#B08036]">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
            </span>
            <div class="text-[#8E8B82] text-xs font-bold uppercase tracking-wider">Có mục tiêu %</div>
          </div>
          <div class="text-3xl font-serif font-semibold text-[#141413]" id="goalCount">--</div>
        </div>
      </div>

      <!-- Search -->
      <div class="relative mb-6 max-w-md">
        <svg class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-[#8E8B82] h-4 w-4 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input
          id="searchInput"
          type="text"
          placeholder="Tìm theo tên, tên thật, Discord, email..."
          class="w-full pl-11 pr-4 py-3 bg-[#FFFFFF] border border-[#E6DFD8] rounded-xl text-[#141413] placeholder-[#8E8B82] focus:border-[#CC785C] focus:ring-2 focus:ring-[#CC785C]/20 focus:outline-none transition-all text-sm font-medium shadow-xs"
        />
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-20">
        <div class="inline-flex items-center gap-3.5 px-7 py-4 rounded-2xl bg-[#FFFFFF] border border-[#E6DFD8] shadow-sm">
          <div class="relative w-6 h-6">
            <div class="absolute inset-0 rounded-full border-2 border-[#E6DFD8]"></div>
            <div class="absolute inset-0 rounded-full border-2 border-[#CC785C] border-t-transparent animate-spin"></div>
          </div>
          <span class="text-base font-semibold text-[#141413]">Đang tải dữ liệu...</span>
        </div>
      </div>

      <!-- Table -->
      <div id="tableWrap" class="hidden bg-[#FFFFFF] border border-[#E6DFD8] rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.03)]">
        <div class="overflow-x-auto">
          <table class="w-full text-sm text-left text-[#3D3D3A]">
            <thead>
              <tr class="border-b border-[#E6DFD8] bg-[#F6F4EE] text-[#6B6860] text-xs uppercase tracking-wider font-bold">
                <th class="px-5 py-4">#</th>
                <th class="px-5 py-4">ID</th>
                <th class="px-5 py-4">Tên hiển thị</th>
                <th class="px-5 py-4">Tên thật</th>
                <th class="px-5 py-4">Discord</th>
                <th class="px-5 py-4">Email</th>
                <th class="px-5 py-4">Zalo/SĐT</th>
                <th class="px-5 py-4">Mục tiêu %</th>
                <th class="px-5 py-4">Nơi ở</th>
                <th class="px-5 py-4">Chuyên ngành</th>
                <th class="px-5 py-4">Giới thiệu</th>
                <th class="px-5 py-4">Duyệt AC11</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-[#F0EAE1]"></tbody>
          </table>
        </div>
      </div>

      <!-- Empty -->
      <div id="emptyMsg" class="hidden text-center py-20 text-[#8E8B82] font-medium">
        Chưa có ai đăng ký cho challenge này.
      </div>
    </div>
  </main>
</Layout>

<script>
  let allUsers: any[] = [];
  let currentChallengeId = "4"; // Mặc định AC11

  async function loadChallenges() {
    try {
      const res = await fetch("/api/data/challenges?v=" + Date.now());
      const data = await res.json();
      const select = document.getElementById("challengeSelect") as HTMLSelectElement;
      select.innerHTML = Object.entries(data)
        .map(([id, c]: any) => `<option value="${id}" ${id === currentChallengeId ? "selected" : ""}>${c.name}</option>`)
        .join("");
      select.addEventListener("change", () => {
        currentChallengeId = select.value;
        renderTable();
      });
    } catch (e) {
      console.error("Load challenges error:", e);
    }
  }

  async function loadUsers() {
    try {
      const res = await fetch("/api/data/users?v=" + Date.now());
      const data = await res.json();
      allUsers = Array.isArray(data?.data) ? data.data : [];
    } catch (e) {
      console.error("Load users error:", e);
    }
  }

  function renderTable() {
    const search = (document.getElementById("searchInput") as HTMLInputElement)?.value.trim().toLowerCase() || "";
    const query = parseInt(currentChallengeId);

    const list = allUsers.filter((u) =>
      (u.challengeIds || []).includes(query),
    );

    (document.getElementById("regCount") as HTMLElement).textContent = String(list.length);
    (document.getElementById("realNameCount") as HTMLElement).textContent = String(list.filter(u => u.realName).length);
    (document.getElementById("zaloCount") as HTMLElement).textContent = String(list.filter(u => u.zaloUrl).length);
    (document.getElementById("goalCount") as HTMLElement).textContent = String(list.filter(u => u.attendanceGoal != null).length);

    const filtered = list.filter((u) =>
      [u.name, u.realName, u.discordNickname, u.email, u.zaloUrl]
        .some((v) => v && v.toLowerCase().includes(search)),
    );

    const tbody = document.getElementById("tableBody") as HTMLElement;
    const loading = document.getElementById("loading");
    const tableWrap = document.getElementById("tableWrap");
    const emptyMsg = document.getElementById("emptyMsg");

    loading?.classList.add("hidden");

    if (filtered.length === 0) {
      tableWrap?.classList.add("hidden");
      emptyMsg?.classList.remove("hidden");
      return;
    }
    emptyMsg?.classList.add("hidden");
    tableWrap?.classList.remove("hidden");

    const dash = '<span class="text-[#C9C2B7]">—</span>';

    // Cột duyệt AC11 — chỉ hiển thị chức năng khi đang xem AC11 (challenge 4)
    const isAc11 = currentChallengeId === "4";
    const approveCell = (u: any) => {
      if (!isAc11) return dash;
      if (u.ac11Approved) {
        return '<span class="inline-flex items-center gap-1 px-2.5 py-1 bg-[#E7F1EA] text-[#3F6B53] font-bold text-xs rounded-lg border border-[#CBE0D2]">✓ Đã duyệt</span>';
      }
      return `<button class="approve-ac11-btn inline-flex items-center gap-1 px-3 py-1.5 bg-[#CC785C] hover:bg-[#B8684E] active:scale-95 text-white font-bold text-xs rounded-lg shadow-sm transition-all cursor-pointer" data-user-id="${u.id}" data-user-name="${(u.name || '').replace(/"/g, '&quot;')}">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
        Duyệt
      </button>`;
    };

    tbody.innerHTML = filtered.map((u, i) => `
      <tr class="hover:bg-[#FBF7F1]/70 transition-colors">
        <td class="px-5 py-3.5 text-[#8E8B82] font-bold">${i + 1}</td>
        <td class="px-5 py-3.5 font-mono text-xs text-[#8E8B82]">#${u.id}</td>
        <td class="px-5 py-3.5 font-semibold text-[#141413]">${u.name || dash}</td>
        <td class="px-5 py-3.5">${u.realName || dash}</td>
        <td class="px-5 py-3.5 text-xs text-[#6B6860] font-mono">${u.discordNickname ? '@' + u.discordNickname : dash}</td>
        <td class="px-5 py-3.5 text-xs font-mono text-[#6B6860]">${u.email || dash}</td>
        <td class="px-5 py-3.5 text-xs font-mono">${u.zaloUrl || dash}</td>
        <td class="px-5 py-3.5 font-bold text-[#CC785C]">${u.attendanceGoal != null ? u.attendanceGoal + '%' : dash}</td>
        <td class="px-5 py-3.5 text-xs">${u.place || dash}</td>
        <td class="px-5 py-3.5 text-xs">${u.major || dash}</td>
        <td class="px-5 py-3.5 text-xs text-[#6B6860] max-w-[180px] truncate" title="${(u.bio || '').replace(/"/g, '&quot;')}">${u.bio || dash}</td>
        <td class="px-5 py-3.5">${approveCell(u)}</td>
      </tr>
    `).join("");
  }

  // Xử lý bấm nút Duyệt AC11 → gọi endpoint -> gán role Discord
  document.getElementById("tableBody")?.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest(".approve-ac11-btn") as HTMLElement | null;
    if (!btn) return;
    const userId = btn.getAttribute("data-user-id");
    const userName = btn.getAttribute("data-user-name") || userId;
    if (!userId) return;

    if (!confirm(`Duyệt đăng ký AC11 cho "${userName}"? Role Discord sẽ được gán tự động.`)) return;

    btn.disabled = true;
    btn.innerHTML = '<span class="inline-flex items-center gap-1"><svg class="animate-spin h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle class="opacity-25" cx="12" cy="12" r="10"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12z"/></svg> Đang xử lý...</span>';

    try {
      const res = await fetch("/api/admin/approve-ac11", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: parseInt(userId) }),
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message || "Đã duyệt thành công!");
        renderTable();
      } else {
        alert("Lỗi: " + (data.error || "Không thể duyệt"));
        btn.disabled = false;
        btn.textContent = "Duyệt";
      }
    } catch (err: any) {
      alert("Lỗi hệ thống: " + err.message);
      btn.disabled = false;
      btn.textContent = "Duyệt";
    }
  });

  document.getElementById("searchInput")?.addEventListener("input", renderTable);

  (async () => {
    await Promise.all([loadChallenges(), loadUsers()]);
    renderTable();
  })();
</script>
