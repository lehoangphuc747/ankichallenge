  }

  // Function to download certificate - tính toán từ JSON files thay vì gọi API
  (window as any).downloadCertificate = async function(userId: any, challengeId: any, format: any) {
    try {
      // Fetch data từ JSON files (thêm cache-busting)
      const cb = '?v=' + Date.now();
      const [usersRes, challengesRes] = await Promise.all([
        fetch('/api/data/users' + cb),
        fetch('/api/data/challenges' + cb)
      ]);

      if (!usersRes.ok || !challengesRes.ok) {
        throw new Error('Không thể tải dữ liệu');
      }

      const usersData = await usersRes.json();
      const challengesData = await challengesRes.json();

      // Find user
      const user = usersData.data.find((u: any) => u.id === parseInt(userId));
      if (!user) throw new Error('Không tìm thấy người dùng');

      // Find challenge
      const challenge = challengesData[challengeId];
      if (!challenge) throw new Error('Không tìm thấy challenge');

      // Fetch specific records
      let prefix = '08';
      if (challengeId == 1) prefix = '08';
      if (challengeId == 2) prefix = '09';
      if (challengeId == 3) prefix = '10';
      if (challengeId == 4) prefix = '11';
      const recordsRes = await fetch(`/api/data/records_${prefix}` + cb);
      const studyRecordsData = await recordsRes.json();

      // Tính toán stats
      const startDate = new Date(challenge.start);
      const endDate = new Date(challenge.end);
      
      let totalDays = 0;
      let studyDays = 0;
      
      for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
        totalDays++;
        const dateStr = d.toISOString().split('T')[0];
        if (studyRecordsData[dateStr] && studyRecordsData[dateStr][userId]) {
          studyDays++;
        }
      }

      const attendanceRate = totalDays > 0 ? Math.round((studyDays / totalDays) * 100) : 0;
      
      const today = new Date();
      const completionDate = endDate < today ? endDate : today;
      const formattedDate = completionDate.toLocaleDateString('vi-VN', {
        day: '2-digit',
        month: '2-digit',
        year: 'numeric'
      });

      const data = {
        userName: user.name,
        challengeName: challenge.name,
        studyDays,
        totalDays,
        attendanceRate,
        completionDate: formattedDate
      };
      
      if (format === 'html') {
        // Generate full HTML
        const htmlContent = generateCertificateHTML(data);
        const blob = new Blob([htmlContent], { type: 'text/html' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `certificate_${data.userName.replace(/\s/g, '_')}_${data.challengeName.replace(/\s/g, '_')}.html`;
        a.click();
        URL.revokeObjectURL(url);
      }
    } catch (error) {
      console.error('Error downloading certificate:', error);
      alert('Không thể tải chứng chỉ. Vui lòng thử lại sau.');
    }
  };

