          const statStyles = window.getComputedStyle(statVal);
          const isFirst = i === 0;
          const expectedColor = isFirst ? 'rgb(22, 163, 74) / #16a34a (green-600)' : 'rgb(37, 99, 235) / #2563eb (blue-600)';
        });
        
        // Check stats row
        const statsRow = card.querySelector('.cert-stats-row');
        if (statsRow) {
          const statsRowStyles = window.getComputedStyle(statsRow);
