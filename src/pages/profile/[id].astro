---
import Layout from '../../layouts/Layout.astro';
import CertificateCardStyles from '../../components/CertificateCardStyles.astro';

// Import dữ liệu người dùng để Astro biết trước danh sách `id` khi build static
import usersData from '../../../public/data/users.json';
import { verifySession } from '../../utils/session';

const sessionCookie = Astro.cookies.get('user_session')?.value;
let loggedUser: { id: string; username: string; displayName: string; avatar: string; memberId?: number | null; memberName?: string | null } | null = null;

if (sessionCookie) {
  const env = (Astro.locals as any).runtime?.env ?? {};
  const sessionSecret = env.SESSION_SECRET || import.meta.env.SESSION_SECRET || 'anki_challenge_secret_key_2026_super_secure';
  loggedUser = await verifySession<typeof loggedUser>(sessionCookie, sessionSecret) ?? null;
}

// Astro yêu cầu dynamic route phải khai báo getStaticPaths() để build tĩnh
export function getStaticPaths() {
  const members = (usersData && usersData.data) ? usersData.data : [];
  
  // Trả về danh sách đường dẫn: /profile/9, /profile/10, ...
  return members.map((member: any) => ({
    params: { id: String(member.id) }
  }));
}
