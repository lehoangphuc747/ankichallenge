        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: currentUser.id, updates })
      });
      const data = await res.json();
      if (data.success) {
        if (statusDiv) {
          statusDiv.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30';
          statusDiv.textContent = '✅ Đã cập nhật trang cá nhân thành công!';
          statusDiv.classList.remove('hidden');
