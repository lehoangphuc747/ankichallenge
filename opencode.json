{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "discord": {
      "type": "local",
      "command": ["npx", "-y", "@rayenking/discord-mcp"],
      "enabled": true,
      "environment": {
        "DISCORD_TOKEN": "{env:DISCORD_TOKEN}"
      }
    },
    "discord-plus": {
      "type": "local",
      "command": ["npx", "-y", "discord-mcp-plus"],
      "enabled": true,
      "environment": {
        "DISCORD_TOKEN": "{env:DISCORD_TOKEN}"
      }
    },
    "cf-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cf-api": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false,
      "oauth": {}
    }
  }
}
